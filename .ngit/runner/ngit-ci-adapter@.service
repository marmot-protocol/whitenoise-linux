[Unit]
Description=White Noise isolated ngit worker slot %i
RequiresMountsFor=/var/lib/ngit-ci-vm/slot%i/act-job-cache

[Service]
User=ngit-ci-vm%i
Group=ngit-ci-slot%i
SupplementaryGroups=kvm ngit-ci
StateDirectory=ngit-ci-vm/slot%i
StateDirectoryMode=0700
RuntimeDirectory=ngit-ci-adapter-%i
RuntimeDirectoryMode=0770
WorkingDirectory=/var/lib/ngit-ci-vm/slot%i
ExecStart=/opt/ngit-ci/1dde76e67f7606438f38c0ee676a6b64b7e53560/ngit-ci-adapter-microvm --socket=/run/ngit-ci-adapter-%i/adapter.sock --template=/var/lib/ngit-ci-vm/templates/template-exclusive-cache.qcow2 --state-dir=/var/lib/ngit-ci-vm/slot%i --max-jobs=1 --vcpus=6 --memory-mib=24576 --cache-max-total-bytes=47244640256
Slice=github-build.slice
CPUQuota=640%
MemoryHigh=25G
MemoryMax=26G
MemorySwapMax=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
UMask=0007
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
