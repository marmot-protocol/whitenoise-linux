[Unit]
Description=Mount this job's repository and trust-scoped cache
Before=ssh.service
ConditionCredential=ngit-ci.act-cache

[Service]
Type=oneshot
RemainAfterExit=yes
LoadCredential=ngit-ci.act-cache
ExecStart=/usr/bin/install -d -m 0700 /run/ngit-ci-act-cache
ExecStart=/usr/sbin/modprobe 9pnet_virtio
# The adapter holds an exclusive repository/trust-scoped writer lease.
ExecStart=/usr/bin/mount -t 9p -o trans=virtio,version=9p2000.L,msize=104857600,cache=loose,nodev,nosuid ngit-ci-act-cache /run/ngit-ci-act-cache

[Install]
WantedBy=multi-user.target
