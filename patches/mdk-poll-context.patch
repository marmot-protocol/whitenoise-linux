+#[cfg(test)]
+mod poll_context_tests {
+    use super::*;
+
+    #[test]
+    fn poll_context_is_bounded() {
+        let author = "11".repeat(32);
+        let create = |message_tags| AppMessageIntent::Poll {
+            question: "Drink?".into(),
+            options: vec!["Tea".into(), "Coffee".into()],
+            poll_type: PollType::MultipleChoice,
+            ends_at: Some(200),
+            message_tags,
+        };
+        for key in ["option", "polltype", "endsAt", "response", "imeta"] {
+            let result = build_inner_event(
+                &create(vec![vec![key.into(), "override".into()]]),
+                &author,
+                100,
+            );
+            assert!(matches!(result, Err(AppError::InvalidAppMessagePayload(_))));
+        }
+        let context_slots = cgka_traits::polls::POLL_MAX_TAGS - 4;
+        let context = vec![vec!["p".into(), author.clone()]; context_slots];
+        let event = build_inner_event(&create(context.clone()), &author, 100).unwrap();
+        let definition = cgka_traits::parse_poll(&event).unwrap();
+        assert_eq!(definition.poll_type, PollType::MultipleChoice);
+        assert_eq!(definition.ends_at, Some(200));
+        let mut oversized = context;
+        oversized.push(vec!["p".into(), author.clone()]);
+        assert!(matches!(
+            build_inner_event(&create(oversized), &author, 100),
+            Err(AppError::InvalidAppMessagePayload(_))
+        ));
+        assert!(matches!(
+            build_inner_event(&create(vec![vec!["e".into(), " ".into()]]), &author, 100),
+            Err(AppError::InvalidAppMessagePayload(_))
+        ));
+    }
+}
