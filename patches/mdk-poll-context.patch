+async fn native_polls_keep_context() {
+    let dir = tempfile::tempdir().unwrap();
+    let (_relay, app, url) = mock_app(&dir).await;
+    let runtime = MarmotAppRuntime::new(app);
+    let setup = AccountSetupRequest {
+        default_relays: vec![endpoint(&url)],
+        bootstrap_relays: vec![endpoint(&url)],
+        publish_initial_key_package: true,
+        ..Default::default()
+    };
+    let alice = create_network_ready_identity(&runtime, setup.relay_options_only()).await.account;
+    let bob = create_network_ready_identity(&runtime, setup).await.account;
+    let a = &alice.account_id_hex;
+    let b = &bob.account_id_hex;
+    let mut events = runtime.subscribe();
+    let group = runtime
+        .create_group(a, "Native polls", std::slice::from_ref(b), None)
+        .await
+        .unwrap();
+    wait_for_event(&mut events, |event| {
+        matches!(event, MarmotAppEvent::GroupJoined { account_id_hex, group_id, .. }
+            if account_id_hex == b && group_id == &group)
+    }).await;
+    accept_group_invite_retrying_busy(&runtime, b, &group).await.unwrap();
+    let group_hex = hex::encode(group.as_slice());
+    let query = TimelineMessageQuery {
+        group_id_hex: Some(group_hex.clone()),
+        ..Default::default()
+    };
+    let mut alice_timeline = runtime.subscribe_timeline_messages(a, query.clone()).await.unwrap();
+    let mut bob_timeline = runtime.subscribe_timeline_messages(b, query).await.unwrap();
+
+    for issue in [false, true] {
+        let root = if issue {
+            runtime.send_custom_event(
+                a, &group, 1621,
+                vec![vec!["subject".into(), "Choose a drink".into()]],
+                "Issue description".into(),
+            ).await.unwrap()
+        } else {
+            runtime.send_message(a, &group, b"Thread discussion".to_vec()).await.unwrap()
+        };
+        let root_id = &root.message_ids[0];
+        let tags = if issue {
+            vec![
+                vec!["E".into(), root_id.clone(), String::new(), a.clone()],
+                vec!["K".into(), "1621".into()],
+                vec!["P".into(), a.clone()],
+                vec!["e".into(), root_id.clone(), String::new(), a.clone()],
+                vec!["k".into(), "1621".into()],
+                vec!["p".into(), a.clone()],
+            ]
+        } else {
+            vec![vec!["e".into(), root_id.clone()]]
+        };
+        let mode = if issue {
+            cgka_traits::PollType::MultipleChoice
+        } else {
+            cgka_traits::PollType::SingleChoice
+        };
+        let sent = runtime.create_poll(
+            a, &group, "Drink?".into(), vec!["Tea".into(), "Coffee".into()],
+            mode, None, tags,
+        ).await.unwrap();
+        let poll_id = &sent.message_ids[0];
+        wait_for_timeline_update(&mut bob_timeline, |update| {
+            matches!(update, marmot_app::RuntimeTimelineMessageUpdate::Projection(projection)
+                if projection.update.timeline_messages.iter().any(|message|
+                    message.message_id_hex == *poll_id && message.poll.is_some()))
+        }).await;
+        let peer = runtime.timeline_message(b, &group_hex, poll_id).unwrap().unwrap();
+        assert_eq!(peer.reply_to_message_id_hex.as_deref(), Some(root_id.as_str()));
+        assert_eq!(
+            peer.reply_preview.as_ref().unwrap().plaintext,
+            if issue { "Issue description" } else { "Thread discussion" },
+        );
+        if issue {
+            assert_eq!(tag_value(&peer.tags, "E"), Some(root_id.as_str()));
+            assert_eq!(tag_value(&peer.tags, "K"), Some("1621"));
+        }
+        let initial = peer.poll.unwrap();
+        assert_eq!(initial.question, "Drink?");
+        assert_eq!(initial.poll_type, mode);
+        assert_eq!(initial.options.iter().map(|option| option.label.as_str()).collect::<Vec<_>>(),
+            ["Tea", "Coffee"]);
+        assert_eq!(initial.participants, 0);
+        assert!(initial.open);
+
+        runtime.cast_poll_vote(a, &group, poll_id.clone(), vec!["0".into()]).await.unwrap();
+        let peer_selection = if issue { vec!["0".into(), "1".into()] } else { vec!["1".into()] };
+        runtime.cast_poll_vote(b, &group, poll_id.clone(), peer_selection.clone()).await.unwrap();
+        for timeline in [&mut alice_timeline, &mut bob_timeline] {
+            wait_for_timeline_update(timeline, |update| {
+                matches!(update, marmot_app::RuntimeTimelineMessageUpdate::Projection(projection)
+                    if projection.update.timeline_messages.iter().any(|message|
+                        message.message_id_hex == *poll_id
+                            && message.poll.as_ref().is_some_and(|poll| poll.participants == 2)))
+            }).await;
+        }
+        for (account, selected) in [(a, vec!["0".to_owned()]), (b, peer_selection)] {
+            let projected = runtime.timeline_message(account, &group_hex, poll_id)
+                .unwrap().unwrap().poll.unwrap();
+            assert_eq!(projected.participants, 2);
+            assert_eq!(projected.local_selection, selected);
+            assert_eq!(projected.options[0].votes, if issue { 2 } else { 1 });
+            assert_eq!(projected.options[1].votes, 1);
+        }
+    }
+    drop(alice_timeline);
+    drop(bob_timeline);
+    runtime.shutdown_and_close().await.unwrap();
+}
