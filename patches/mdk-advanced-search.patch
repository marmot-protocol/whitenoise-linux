 #[test]
+fn advanced_search_pages_all_history_with_equal_timestamp_cursors() {
+    let store = SqliteAccountStorage::in_memory().unwrap();
+    for index in 0..257 {
+        let mut event = chat(&format!("{index:064x}"), "alice", 42, "needle");
+        if index % 2 == 1 {
+            event.group_id_hex = "22".repeat(32);
+        }
+        store.record_app_event(&event).unwrap();
+    }
+    for index in 0..150 {
+        store
+            .record_app_event(&chat(
+                &format!("unmatched-{index}"),
+                "alice",
+                500 + index,
+                "not a match",
+            ))
+            .unwrap();
+    }
+    let mut query = TimelineMessageQuery {
+        search: Some("needle".to_owned()),
+        search_wall_clock: true,
+        pagination: TimelinePagination {
+            limit: Some(100),
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    let mut observed = Vec::new();
+    for (start, end, more) in [(157, 257, true), (57, 157, true), (0, 57, false)] {
+        let page = store.message_timeline(query.clone()).unwrap();
+        let expected = (start..end)
+            .map(|index| format!("{index:064x}"))
+            .collect::<Vec<_>>();
+        assert_eq!(
+            ids(&page),
+            expected.iter().map(String::as_str).collect::<Vec<_>>()
+        );
+        assert_eq!(page.has_more_before, more);
+        let oldest = page.messages.first().unwrap();
+        query.pagination.before = Some(oldest.timeline_at);
+        query.pagination.before_message_id = Some(oldest.message_id_hex.clone());
+        query.cursor_group_id = Some(oldest.group_id_hex.clone());
+        observed.extend(
+            page.messages
+                .into_iter()
+                .map(|message| message.message_id_hex),
+        );
+    }
+    observed.sort();
+    assert_eq!(
+        observed,
+        (0..257)
+            .map(|index| format!("{index:064x}"))
+            .collect::<Vec<_>>()
+    );
+    assert!(store.message_timeline(query).unwrap().messages.is_empty());
+}
