+#[test]
+fn advanced_search_attachment_mime_predicates_match_each_attachment() {
+    let store = SqliteAccountStorage::in_memory().unwrap();
+    for (id, mime) in [
+        ("image", Some("m IMAGE/PNG")),
+        ("video", Some("m video/mp4")),
+        ("audio", Some("m audio/ogg")),
+        ("file", Some("m application/pdf")),
+        ("unknown", None),
+    ] {
+        let mut event = chat(id, "alice", 10, "attachment");
+        let mut tag = vec![
+            "imeta".to_owned(),
+            "url https://example.test/file".to_owned(),
+        ];
+        if let Some(mime) = mime {
+            tag.push(mime.to_owned());
+        }
+        event.tags = vec![tag];
+        store.record_app_event(&event).unwrap();
+    }
+    let mut mixed = chat("mixed", "alice", 10, "attachment");
+    mixed.tags = vec![
+        vec!["imeta".into(), "m image/jpeg".into()],
+        vec!["imeta".into(), "m text/plain".into()],
+    ];
+    store.record_app_event(&mixed).unwrap();
+    store
+        .record_app_event(&chat("text", "alice", 10, "attachment"))
+        .unwrap();
+    for (attachment_type, expected) in [
+        (TimelineAttachmentType::Image, vec!["image", "mixed"]),
+        (TimelineAttachmentType::Video, vec!["video"]),
+        (TimelineAttachmentType::Audio, vec!["audio"]),
+        (
+            TimelineAttachmentType::File,
+            vec!["file", "mixed", "unknown"],
+        ),
+        (
+            TimelineAttachmentType::Attachment,
+            vec!["audio", "file", "image", "mixed", "unknown", "video"],
+        ),
+    ] {
+        let page = store
+            .message_timeline(TimelineMessageQuery {
+                attachment_type,
+                search_wall_clock: true,
+                ..Default::default()
+            })
+            .unwrap();
+        assert_eq!(ids(&page), expected);
+    }
+}
