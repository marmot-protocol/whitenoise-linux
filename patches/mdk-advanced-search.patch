+#[test]
+fn advanced_search_treats_wildcards_whitespace_and_query_syntax_literally() {
+    let store = SqliteAccountStorage::in_memory().unwrap();
+    for (id, text) in [
+        ("percent", "cost 10%"),
+        ("underscore", "a_b"),
+        ("backslash", r"a\b"),
+        ("spaces", "  padded  "),
+        ("syntax", "from:alice \"hello\""),
+        ("decoy", "cost 100 axb padded from:alice hello"),
+    ] {
+        store
+            .record_app_event(&chat(id, "alice", 10, text))
+            .unwrap();
+    }
+    for (search, expected) in [
+        ("%", "percent"),
+        ("_", "underscore"),
+        (r"\", "backslash"),
+        ("  padded  ", "spaces"),
+        ("from:alice \"hello\"", "syntax"),
+    ] {
+        let page = store
+            .message_timeline(TimelineMessageQuery {
+                search: Some(search.to_owned()),
+                search_wall_clock: true,
+                ..Default::default()
+            })
+            .unwrap();
+        assert_eq!(ids(&page), [expected]);
+    }
+    assert!(
+        store
+            .message_timeline(TimelineMessageQuery {
+                search: Some("paddde".to_owned()),
+                ..Default::default()
+            })
+            .unwrap()
+            .messages
+            .is_empty()
+    );
+}
