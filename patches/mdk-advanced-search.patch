+#[test]
+fn advanced_search_cursor_distinguishes_same_message_id_in_different_groups() {
+    let store = SqliteAccountStorage::in_memory().unwrap();
+    for group in ["11".repeat(32), "22".repeat(32)] {
+        let mut event = chat("duplicate", "alice", 42, "needle");
+        event.source_message_id_hex = Some(format!("source-{group}"));
+        event.group_id_hex = group;
+        store.record_app_event(&event).unwrap();
+    }
+    let mut query = TimelineMessageQuery {
+        search_wall_clock: true,
+        pagination: TimelinePagination {
+            limit: Some(1),
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    let head = store.message_timeline(query.clone()).unwrap();
+    assert_eq!(head.messages[0].group_id_hex, "22".repeat(32));
+    assert!(head.has_more_before);
+    query.pagination.before = Some(42);
+    query.pagination.before_message_id = Some("duplicate".to_owned());
+    assert!(store.message_timeline(query.clone()).is_err());
+    query.cursor_group_id = Some("22".repeat(32));
+    let older = store.message_timeline(query.clone()).unwrap();
+    assert_eq!(ids(&older), ["duplicate"]);
+    assert_eq!(older.messages[0].group_id_hex, "11".repeat(32));
+    assert!(!older.has_more_before);
+    query.cursor_group_id = Some("11".repeat(32));
+    assert!(store.message_timeline(query).unwrap().messages.is_empty());
+}
