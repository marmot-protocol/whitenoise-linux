+#[test]
+fn advanced_search_group_filter_uses_wall_clock_not_epoch_order() {
+    let store = SqliteAccountStorage::in_memory().unwrap();
+    for (id, at, epoch) in [("older", 10, 9), ("newer", 20, 7)] {
+        let mut event = chat(id, "alice", at, "needle");
+        event.source_epoch = Some(epoch);
+        store.record_app_event(&event).unwrap();
+    }
+    let mut query = TimelineMessageQuery {
+        group_id_hex: Some("11".repeat(32)),
+        search_wall_clock: true,
+        pagination: TimelinePagination {
+            limit: Some(1),
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    let head = store.message_timeline(query.clone()).unwrap();
+    assert_eq!(ids(&head), ["newer"]);
+    assert!(head.has_more_before);
+    query.pagination.before = Some(20);
+    query.pagination.before_message_id = Some("newer".to_owned());
+    let older = store.message_timeline(query).unwrap();
+    assert_eq!(ids(&older), ["older"]);
+    assert!(!older.has_more_before);
+}
