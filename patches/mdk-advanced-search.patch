+#[test]
+fn advanced_search_filters_apply_before_limit_and_date_bounds_are_half_open() {
+    let store = SqliteAccountStorage::in_memory().unwrap();
+    for index in 0..150 {
+        store
+            .record_app_event(&chat(
+                &format!("noise-{index}"),
+                "bob",
+                500 + index,
+                "needle",
+            ))
+            .unwrap();
+    }
+    for (id, sender, at, other_group) in [
+        ("before", "alice", 99, false),
+        ("since", "alice", 100, false),
+        ("inside", "alice", 199, false),
+        ("until", "alice", 200, false),
+        ("sender", "bob", 150, false),
+        ("group", "alice", 150, true),
+    ] {
+        let mut event = chat(id, sender, at, "needle");
+        if other_group {
+            event.group_id_hex = "22".repeat(32);
+        }
+        event.tags = vec![vec!["imeta".into(), "m image/png".into()]];
+        store.record_app_event(&event).unwrap();
+    }
+    store
+        .record_app_event(&chat("no-attachment", "alice", 170, "needle"))
+        .unwrap();
+    let query = TimelineMessageQuery {
+        group_id_hex: Some("11".repeat(32)),
+        search: Some("needle".to_owned()),
+        sender: Some("alice".to_owned()),
+        since: Some(100),
+        until: Some(200),
+        attachment_type: TimelineAttachmentType::Image,
+        search_wall_clock: true,
+        pagination: TimelinePagination {
+            limit: Some(1),
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    let first = store.message_timeline(query.clone()).unwrap();
+    assert_eq!(ids(&first), ["inside"]);
+    assert!(first.has_more_before);
+    let second = store
+        .message_timeline(TimelineMessageQuery {
+            pagination: TimelinePagination {
+                before: Some(199),
+                before_message_id: Some("inside".to_owned()),
+                limit: Some(1),
+                ..Default::default()
+            },
+            ..query
+        })
+        .unwrap();
+    assert_eq!(ids(&second), ["since"]);
+    assert!(!second.has_more_before);
+}
