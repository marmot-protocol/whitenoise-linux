+    // The two entries encode to exactly 8192 bytes, including ids and lengths.
+    for (id, len) in [(0xf000, 4096), (0xf001, 4088), (0xf001, 4088)] {
+        let sent = alice
+            .send(SendIntent::UpdateAppComponents {
+                group_id: gid.clone(),
+                updates: vec![AppComponentData {
+                    component_id: id,
