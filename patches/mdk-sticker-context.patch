+#[test]
+fn sticker_intent_appends_bounded_context() {
+    let sticker_ref = AppStickerRef {
+        pack_coordinate: format!("30031:{}:cats", "ab".repeat(32)),
+        shortcode: "wave".to_owned(),
+        plaintext_sha256: "11".repeat(32),
+    };
+    let reply = "22".repeat(32);
+    let event = build(AppMessageIntent::Sticker {
+        sticker_ref: sticker_ref.clone(),
+        message_tags: vec![
+            vec!["e".to_owned(), reply.clone()],
+            vec!["effect".to_owned(), "confetti".to_owned()],
+        ],
+    });
+    assert_eq!(event.tags[0][0], "sticker");
+    assert_eq!(event.tags[1], vec!["e".to_owned(), reply]);
+    assert_eq!(event.tags.len(), 3);
+    for tag in [
+        vec!["sticker".to_owned(), "x".to_owned()],
+        vec!["imeta".to_owned(), "url x".to_owned()],
+        vec!["e".to_owned(), " ".to_owned()],
+    ] {
+        let result = build_inner_event(
+            &AppMessageIntent::Sticker {
+                sticker_ref: sticker_ref.clone(),
+                message_tags: vec![tag],
+            },
+            SENDER_HEX,
+            1,
+        );
+        assert!(result.is_err());
+    }
+}
