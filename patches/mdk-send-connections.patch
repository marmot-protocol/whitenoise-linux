+    pub(super) async fn publish_signed_event(
+        &self,
+        fallback: &dyn NostrRelayClient,
+        endpoints: &[TransportEndpoint],
+        event: &NostrTransportEvent,
+        required_acks: usize,
+    ) -> Result<NostrPublishOutcome, TransportAdapterError> {
