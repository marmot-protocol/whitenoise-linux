+    let signed = EventBuilder::new(Kind::TextNote, "mixed quorum")
+        .finalize(&Keys::generate())
+        .unwrap();
+    let event = NostrTransportEvent::from_nostr_event(&signed).unwrap();
+    let outcome = timeout(
+        Duration::from_secs(10),
