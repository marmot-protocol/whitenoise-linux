+            sdk.publish_release_attempts
+                .lock()
+                .await
+                .contains_key(&relay_url)
+        );
+        assert!(!release.is_finished());
+        release.abort();
+        assert!(release.await.unwrap_err().is_cancelled());
+        connect.abort();
+        let _ = connect.await;
+        for _ in 0..100 {
+            if sdk
+                .client()
+                .relay(endpoint.as_str())
+                .await
+                .unwrap()
+                .is_none()
+            {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+        assert!(
+            sdk.client()
+                .relay(endpoint.as_str())
+                .await
+                .unwrap()
+                .is_none()
+        );
+    }
