+            client
+                .try_connect_relay(stalled, Duration::from_secs(30))
+                .await
+        });
+        let (_stream, _) = listener.accept().await.unwrap();
+        let release = tokio::spawn(lease.release());
+        for _ in 0..100 {
+            if sdk
+                .publish_release_attempts
+                .lock()
+                .await
+                .contains_key(&relay_url)
