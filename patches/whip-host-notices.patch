+view_needs_pane :: proc(app: ^App, id: proto.Pane_Id) -> bool {
+	if !view_has_content(app) && !(app.target.kind == .Projects && app.host_notice != nil) {
+		return false
+	}
+	loc, ok := model.find_pane(&app.session, id)
+	if !ok {
+		return false
+	}
+	ws := &app.session.workspaces[loc.ws]
+	switch app.target.kind {
+	case .Session, .Projects:
+		return true
+	case .Project:
+		return ws.id == app.target.id
+	case .Tab:
+		return ws.tabs[loc.tab].id == app.target.id
+	case .Tabs:
+		return false
+	}
+	return false
+}
 
