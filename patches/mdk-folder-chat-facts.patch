+#[test]
+fn folder_mentions_use_original_typed_tags_and_unread_membership() {
+    let store = setup_store().app_storage();
+    let typed = |_: &str, tags: &[Vec<String>]| {
+        tags.iter().any(|tag| {
+            tag.first().map(String::as_str) == Some("p")
+                && tag.get(1).map(String::as_str) == Some(LOCAL)
+        })
+    };
+    let tags = |key: &str| vec![vec!["p".to_owned(), key.to_owned()]];
+    store.initialize_chat_read_state(LOCAL, GROUP, &mentions_local).unwrap();
+    for event in [
+        chat("plain", REMOTE, 10, LOCAL),
+        chat_with_tags("other", REMOTE, 20, "other recipient", tags(REMOTE)),
+        chat_with_tags("own", LOCAL, 30, "self send", tags(LOCAL)),
+    ] {
+        store.record_app_event(&event).unwrap();
+    }
+    let row = store.refresh_chat_list_row(LOCAL, GROUP, &mentions_local).unwrap().unwrap();
+    assert_eq!(row.unread_mention_count, 1);
+    assert!(store.folder_unread_mentions(&typed).unwrap().is_empty());
+
+    store.record_app_event(&chat_with_tags("typed", REMOTE, 40, "hello", tags(LOCAL))).unwrap();
+    store.record_app_event(&chat("newer", REMOTE, 50, LOCAL)).unwrap();
+    store.refresh_chat_list_row(LOCAL, GROUP, &mentions_local).unwrap();
+    assert_eq!(store.folder_unread_mentions(&typed).unwrap(), vec![GROUP.to_owned()]);
+    let row = store.mark_timeline_message_read(LOCAL, GROUP, "typed", &mentions_local).unwrap().unwrap();
+    assert_eq!(row.unread_mention_count, 1);
+    assert!(store.folder_unread_mentions(&typed).unwrap().is_empty());
+}
