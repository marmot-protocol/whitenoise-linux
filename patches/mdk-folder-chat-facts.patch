+#[test]
+fn folder_mentions_skip_non_candidate_unread_history() {
+    let store = setup_store();
+    let app = store.app_storage();
+    app.initialize_chat_read_state(LOCAL, GROUP, &mentions_local)
+        .unwrap();
+
+    let read_steps = || {
+        let conn = store.lock().unwrap();
+        let mut stmt = conn
+            .prepare(SqliteAppStorage::FOLDER_UNREAD_MENTIONS_SQL)
+            .unwrap();
+        let mut rows = stmt.query([]).unwrap();
+        assert!(rows.next().unwrap().is_none());
+        drop(rows);
+        stmt.get_status(rusqlite::StatementStatus::VmStep)
+    };
+
+    let add_ordinary = |range: std::ops::Range<u64>| {
+        let count = range.end;
+        for n in range {
+            app.record_app_event(&chat(&format!("ordinary-{n}"), REMOTE, n + 1, "hello"))
+                .unwrap();
+        }
+        let row = app
+            .refresh_chat_list_row(LOCAL, GROUP, &mentions_local)
+            .unwrap()
+            .unwrap();
+        assert_eq!(row.unread_count, count);
+        assert_eq!(row.unread_mention_count, 0);
+        assert!(app.folder_unread_mentions(&mentions_local).unwrap().is_empty());
+    };
+
+    add_ordinary(0..1);
+    let baseline = read_steps();
+    add_ordinary(1..128);
+    assert_eq!(read_steps(), baseline);
+}
