+    // Require a candidate-only scan even if most unread messages are mentions.
+    const FOLDER_UNREAD_MENTIONS_SQL: &str = "SELECT unread.group_id_hex, timeline.tags_json
+         FROM chat_list_unread_messages AS unread
+             INDEXED BY idx_wn_folder_unread_mention_candidates
+         CROSS JOIN message_timeline AS timeline
+         WHERE unread.mentions_local = 1
+           AND timeline.group_id_hex = unread.group_id_hex
+           AND timeline.message_id_hex = unread.message_id_hex";
+
+    /// Chats with an unread message whose original tags match the supplied predicate.
+    /// The unread membership projection already accounts for read order, imports,
+    /// deleted messages, blocked senders, and the receiving account.
+    pub fn folder_unread_mentions(
+        &self,
+        has_typed_mention: &MentionClassifier<'_>,
+    ) -> StorageResult<Vec<String>> {
+        let conn = self.lock()?;
+        // Install on first use so existing account databases get the index too.
+        conn.prepare_cached(
+            "CREATE INDEX IF NOT EXISTS idx_wn_folder_unread_mention_candidates
+             ON chat_list_unread_messages (group_id_hex, message_id_hex)
+             WHERE mentions_local = 1",
+        )
+        .storage()?
+        .execute([])
+        .storage()?;
+        let mut stmt = conn
+            .prepare_cached(Self::FOLDER_UNREAD_MENTIONS_SQL)
+            .storage()?;
+        let mut rows = stmt.query([]).storage()?;
+        let mut groups = HashSet::new();
+        while let Some(row) = rows.next().storage()? {
+            let group: String = row.get(0).storage()?;
+            if groups.contains(&group) {
+                continue;
+            }
+            let tags = crate::tags_from_json(row.get(1).storage()?).unwrap_or_default();
+            if has_typed_mention("", &tags) {
+                groups.insert(group);
+            }
+        }
+        Ok(groups.into_iter().collect())
+    }
+
+    /// Chats with queued submissions or messages still awaiting delivery.
+    /// An older pending send can be absent from the latest-message preview.
+    pub fn folder_pending_sends(&self) -> StorageResult<Vec<String>> {
+        let conn = self.lock()?;
+        let activity = chat_list_activity_filter_sql("timeline.");
+        let mut stmt = conn.prepare_cached(&format!(
+            "SELECT group_id_hex FROM local_message_submissions WHERE state = 0
+             UNION
+             SELECT event.group_id_hex
+             FROM app_events AS event
+             CROSS JOIN message_timeline AS timeline
+             WHERE event.direction = 'sent'
+               AND event.source_message_id_hex IS NULL AND event.invalidated = 0
+               AND timeline.group_id_hex = event.group_id_hex
+               AND timeline.message_id_hex = event.message_id_hex
+               AND timeline.invalidation_status IS NULL AND timeline.deleted = 0
+               AND timeline.recipient_confirmed = 0 AND {activity}"
+        )).storage()?;
+        stmt.query_map([], |row| row.get(0))
+            .storage()?
+            .collect::<Result<Vec<_>, _>>()
+            .storage()
+    }
