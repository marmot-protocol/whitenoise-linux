+fn folder_pending_sends_ignore_newer_previews_and_settled_sends() {
+    let store = setup_store().app_storage();
+    let mut pending = chat("pending", LOCAL, 10, "optimistic send");
+    pending.source_message_id_hex = None;
+    store.record_app_event(&pending).unwrap();
+    store.record_app_event(&chat("newer", REMOTE, 20, "incoming")).unwrap();
+    let row = store.refresh_chat_list_row(LOCAL, GROUP, &no_mentions).unwrap().unwrap();
+    assert_eq!(row.last_message.unwrap().message_id_hex, "newer");
+    assert_eq!(store.folder_pending_sends().unwrap(), vec![GROUP.to_owned()]);
+
+    store.invalidate_app_event_by_message_id(GROUP, "pending", "local_publish_failed").unwrap();
+    assert!(store.folder_pending_sends().unwrap().is_empty());
+
+    let mut retry = chat("retry", LOCAL, 30, "retry");
+    retry.source_message_id_hex = None;
+    store.record_app_event(&retry).unwrap();
+    assert_eq!(store.folder_pending_sends().unwrap(), vec![GROUP.to_owned()]);
+    retry.source_message_id_hex = Some("source-retry".to_owned());
+    store.record_app_event(&retry).unwrap();
+    assert!(store.folder_pending_sends().unwrap().is_empty());
