+#[test]
+fn comment_chat_features() {
+    let store = SqliteAccountStorage::in_memory().unwrap();
+    let mut comment = chat("comment", "alice", 1, "original");
+    comment.kind = COMMENT_KIND;
+    comment.tags = vec![vec!["e".into(), "issue".into()], vec!["imeta".into(), "url https://example.com/image.png".into(), "m image/png".into()]];
+    store.record_app_event(&comment).unwrap();
+    let group = &comment.group_id_hex;
+    let original = store.timeline_message(group, "comment").unwrap().unwrap();
+    assert_eq!(original.reply_to_message_id_hex.as_deref(), Some("issue"));
+    assert!(original.media.is_some());
+    store.record_app_event(&edit("edit", "alice", "comment", 2, "updated")).unwrap();
+    store.record_app_event(&edit("forged", "bob", "comment", 9, "forged")).unwrap();
+    store.record_app_event(&reaction("react", "bob", "comment", 3, "+")).unwrap();
+    let updated = store.timeline_message(group, "comment").unwrap().unwrap();
+    assert_eq!(updated.plaintext, "updated");
+    assert_eq!(updated.edit.unwrap().edit_count, 1);
+    assert_eq!(updated.reactions.user_reactions.len(), 1);
+    assert_eq!(store.message_edit_history(group, "comment", None, 100).unwrap().versions.len(), 1);
+    store.record_app_event(&delete("delete", "alice", "comment", 4)).unwrap();
+    assert!(store.timeline_message(group, "comment").unwrap().unwrap().deleted);
+}
