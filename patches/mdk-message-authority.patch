+#[tokio::test]
+async fn linux_issue_two_clients() {
+    let alice_dir = tempfile::tempdir().unwrap();
+    let bob_dir = tempfile::tempdir().unwrap();
+    let (_relay, alice_app, url) = mock_app(&alice_dir).await;
+    let bob_app = MarmotApp::with_relay_and_config(
+        bob_dir.path(),
+        url.clone(),
+        MarmotAppConfig::white_noise().with_allow_loopback_relay_endpoints(true),
+    );
+    let alice_rt = MarmotAppRuntime::new(alice_app.clone());
+    let bob_rt = MarmotAppRuntime::new(bob_app.clone());
+    let setup = AccountSetupRequest {
+        default_relays: vec![endpoint(&url)],
+        bootstrap_relays: vec![endpoint(&url)],
+        publish_initial_key_package: true,
+        ..AccountSetupRequest::default()
+    };
+    let alice = create_network_ready_identity(&alice_rt, setup.relay_options_only())
+        .await
+        .account;
+    let bob = create_network_ready_identity(&bob_rt, setup).await.account;
+    let mut bob_events = bob_rt.subscribe();
+    let group = alice_rt
+        .create_group(
+            &alice.account_id_hex,
+            "Issues",
+            std::slice::from_ref(&bob.account_id_hex),
+            None,
+        )
+        .await
+        .unwrap();
+    wait_for_event(
+        &mut bob_events,
+        |event| matches!(event, MarmotAppEvent::GroupJoined { group_id, .. } if group_id == &group),
+    )
+    .await;
+    accept_group_invite_retrying_busy(&bob_rt, &bob.account_id_hex, &group)
+        .await
+        .unwrap();
+    let forbidden = bob_rt
+        .update_app_component(&bob.account_id_hex, &group, 0xf301, vec![1, 1])
+        .await
+        .unwrap_err();
+    assert!(matches!(
+        forbidden.as_engine_error(),
+        Some(cgka_traits::EngineError::NotGroupAdmin { .. })
+    ));
+    alice_rt
+        .update_app_component(&alice.account_id_hex, &group, 0xf301, vec![1, 1])
+        .await
+        .unwrap();
+    wait_app_component(&bob_rt, &bob.account_id_hex, &group, &[1, 1]).await;
+    let report = bob_rt
+        .send_custom_event(
+            &bob.account_id_hex,
+            &group,
+            1621,
+            vec![vec!["subject".into(), "Reconnect failure".into()]],
+            "Reproduction steps".into(),
+        )
+        .await
+        .unwrap();
+    let id = report.message_ids[0].clone();
+    let group_hex = hex::encode(group.as_slice());
+    let query = || AppMessageQuery {
+        group_id_hex: Some(group_hex.clone()),
+        kinds: Some(vec![1621, 1111, 1631]),
+        limit: None,
+    };
+    timeout(Duration::from_secs(15), async {
+        while alice_app
+            .messages_with_query(&alice.label, query())
+            .unwrap()
+            .is_empty()
+        {
+            sleep(Duration::from_millis(25)).await;
+        }
+    })
+    .await
+    .unwrap();
+    alice_rt
+        .send_custom_event(
+            &alice.account_id_hex,
+            &group,
+            1111,
+            vec![
+                vec![
+                    "E".into(),
+                    id.clone(),
+                    "".into(),
+                    bob.account_id_hex.clone(),
+                ],
+                vec!["K".into(), "1621".into()],
+                vec!["P".into(), bob.account_id_hex.clone()],
+                vec![
+                    "e".into(),
+                    id.clone(),
+                    "".into(),
+                    bob.account_id_hex.clone(),
+                ],
+                vec!["k".into(), "1621".into()],
+                vec!["p".into(), bob.account_id_hex.clone()],
+            ],
+            "Confirmed".into(),
+        )
+        .await
+        .unwrap();
+    alice_rt
+        .send_custom_event(
+            &alice.account_id_hex,
+            &group,
+            1631,
+            vec![vec!["e".into(), id.clone(), "".into(), "root".into()]],
+            String::new(),
+        )
+        .await
+        .unwrap();
+    timeout(Duration::from_secs(15), async {
+        while bob_app
+            .messages_with_query(&bob.label, query())
+            .unwrap()
+            .len()
+            != 3
+        {
+            sleep(Duration::from_millis(25)).await;
+        }
+    })
+    .await
+    .unwrap();
+    let rows = bob_app.messages_with_query(&bob.label, query()).unwrap();
+    assert!(
+        rows.iter()
+            .find(|r| r.kind == 1621)
+            .unwrap()
+            .authority
+            .is_none()
+    );
+    assert!(
+        rows.iter()
+            .find(|r| r.kind == 1631)
+            .unwrap()
+            .authority
+            .unwrap()
+            .moderation_grant
+    );
+    alice_rt
+        .update_app_component(&alice.account_id_hex, &group, 0xf301, vec![1, 0])
+        .await
+        .unwrap();
+    wait_app_component(&bob_rt, &bob.account_id_hex, &group, &[1, 0]).await;
+    assert_eq!(
+        bob_app
+            .messages_with_query(&bob.label, query())
+            .unwrap()
+            .len(),
+        3
+    );
+    bob_rt.shutdown_and_close().await.unwrap();
+    drop(bob_rt);
+    drop(bob_app);
+    // Enable while the second client is offline, then recover from stored MLS state.
+    alice_rt
+        .update_app_component(&alice.account_id_hex, &group, 0xf301, vec![1, 1])
+        .await
+        .unwrap();
+    let reopened = MarmotApp::with_relay_and_config(
+        bob_dir.path(),
+        url,
+        MarmotAppConfig::white_noise().with_allow_loopback_relay_endpoints(true),
+    );
+    let bob_rt = MarmotAppRuntime::new(reopened.clone());
+    bob_rt.reconcile_accounts().await.unwrap();
+    wait_app_component(&bob_rt, &bob.account_id_hex, &group, &[1, 1]).await;
+    assert_eq!(
+        reopened
+            .messages_with_query(&bob.label, query())
+            .unwrap()
+            .len(),
+        3
+    );
+    bob_rt.shutdown_and_close().await.unwrap();
+    alice_rt.shutdown_and_close().await.unwrap();
+}
