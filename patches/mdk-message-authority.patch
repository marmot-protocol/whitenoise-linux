+            &group,
+            1621,
+            vec![vec!["subject".into(), "Reconnect failure".into()]],
+            "Reproduction steps".into(),
+        )
+        .await
+        .unwrap();
+    let id = report.message_ids[0].clone();
+    let group_hex = hex::encode(group.as_slice());
+    let query = || AppMessageQuery {
+        group_id_hex: Some(group_hex.clone()),
+        kinds: Some(vec![1621, 1111, 1631]),
+        limit: None,
+    };
+    timeout(Duration::from_secs(15), async {
+        while alice_app
+            .messages_with_query(&alice.label, query())
+            .unwrap()
+            .is_empty()
+        {
+            sleep(Duration::from_millis(25)).await;
+        }
+    })
+    .await
+    .unwrap();
+    alice_rt
+        .send_custom_event(
+            &alice.account_id_hex,
+            &group,
+            1111,
+            vec![
+                vec![
+                    "E".into(),
+                    id.clone(),
+                    "".into(),
+                    bob.account_id_hex.clone(),
+                ],
+                vec!["K".into(), "1621".into()],
+                vec!["P".into(), bob.account_id_hex.clone()],
+                vec![
+                    "e".into(),
+                    id.clone(),
+                    "".into(),
+                    bob.account_id_hex.clone(),
+                ],
+                vec!["k".into(), "1621".into()],
+                vec!["p".into(), bob.account_id_hex.clone()],
+            ],
+            "Confirmed".into(),
+        )
+        .await
+        .unwrap();
+    alice_rt
+        .send_custom_event(
+            &alice.account_id_hex,
+            &group,
+            1631,
+            vec![vec!["e".into(), id.clone(), "".into(), "root".into()]],
+            String::new(),
+        )
+        .await
+        .unwrap();
+    timeout(Duration::from_secs(15), async {
+        while bob_app
+            .messages_with_query(&bob.label, query())
+            .unwrap()
+            .len()
+            != 3
+        {
+            sleep(Duration::from_millis(25)).await;
+        }
+    })
+    .await
+    .unwrap();
+    let rows = bob_app.messages_with_query(&bob.label, query()).unwrap();
+    assert!(
+        rows.iter()
+            .find(|r| r.kind == 1621)
+            .unwrap()
+            .authority
+            .is_none()
+    );
+    assert!(
+        rows.iter()
+            .find(|r| r.kind == 1631)
+            .unwrap()
+            .authority
+            .unwrap()
+            .moderation_grant
+    );
+    alice_rt
+        .update_app_component(&alice.account_id_hex, &group, 0xf301, vec![1, 0])
+        .await
+        .unwrap();
+    wait_app_component(&bob_rt, &bob.account_id_hex, &group, &[1, 0]).await;
+    assert_eq!(
+        bob_app
+            .messages_with_query(&bob.label, query())
+            .unwrap()
+            .len(),
+        3
+    );
+    bob_rt.shutdown_and_close().await.unwrap();
+    drop(bob_rt);
+    drop(bob_app);
+    // Enable while the second client is offline, then recover from stored MLS state.
+    alice_rt
+        .update_app_component(&alice.account_id_hex, &group, 0xf301, vec![1, 1])
+        .await
+        .unwrap();
+    let reopened = MarmotApp::with_relay_and_config(
+        bob_dir.path(),
+        url,
+        MarmotAppConfig::default().with_allow_loopback_relay_endpoints(true),
+    );
+    let bob_rt = MarmotAppRuntime::new(reopened.clone());
+    bob_rt.reconcile_accounts().await.unwrap();
+    wait_app_component(&bob_rt, &bob.account_id_hex, &group, &[1, 1]).await;
+    assert_eq!(
+        reopened
+            .messages_with_query(&bob.label, query())
+            .unwrap()
+            .len(),
+        3
+    );
+    bob_rt.shutdown_and_close().await.unwrap();
+    alice_rt.shutdown_and_close().await.unwrap();
+}
