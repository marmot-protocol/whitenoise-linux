+        )
+        .await
+        .unwrap();
+    wait_for_event(
+        &mut bob_events,
+        |event| matches!(event, MarmotAppEvent::GroupJoined { group_id, .. } if group_id == &group),
+    )
+    .await;
+    accept_group_invite_retrying_busy(&bob_rt, &bob.account_id_hex, &group)
+        .await
+        .unwrap();
+    let forbidden = bob_rt
+        .update_app_component(&bob.account_id_hex, &group, 0xf301, vec![1, 1])
+        .await
+        .unwrap_err();
+    assert!(matches!(
+        forbidden.as_engine_error(),
+        Some(cgka_traits::EngineError::NotGroupAdmin { .. })
+    ));
+    alice_rt
+        .update_app_component(&alice.account_id_hex, &group, 0xf301, vec![1, 1])
+        .await
+        .unwrap();
+    wait_app_component(&bob_rt, &bob.account_id_hex, &group, &[1, 1]).await;
+    let report = bob_rt
