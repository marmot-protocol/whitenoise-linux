+#[cfg(test)]
+mod authority_tests {
+    use super::*;
+
+    #[test]
+    fn raw_message_source_authority() {
+        for grant in [None, Some(false), Some(true)] {
+            let record = AppMessageRecord {
+                authority: grant.map(|moderation_grant| {
+                    cgka_traits::app_event::AppMessageAuthority {
+                        source_context: [7; 32],
+                        moderation_grant,
+                    }
+                }),
+                message_id_hex: "id".into(),
+                direction: "incoming".into(),
+                group_id_hex: "group".into(),
+                sender: "sender".into(),
+                plaintext: String::new(),
+                kind: 1631,
+                tags: Vec::new(),
+                source_epoch: Some(4),
+                retention: None,
+                recorded_at: 10,
+                received_at: 11,
+                insert_order: 1,
+                invalidated: true,
+                // This legacy field must never stand in for source evidence.
+                moderation_grant: true,
+            };
+            let ffi = AppMessageRecordFfi::from(record);
+            assert_eq!(ffi.moderation_grant, grant);
+            assert!(ffi.invalidated);
+        }
+    }
+}
