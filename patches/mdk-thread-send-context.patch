+/// Check whether the local timeline can place a new thread reply. This
+/// synchronous read does not upload or publish. A successful read writes 0 to
+/// `available` for a missing or deleted parent, or if root evidence is missing.
+/// Pass NULL for `out` to check availability only. Otherwise free the returned
+/// context with `marmot_thread_reply_context_free`.
+///
+/// # Safety
+/// `client` must be live; strings valid; `available` writable; `out` writable
+/// if non-NULL.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn marmot_thread_reply_context(
+    client: *const MarmotClient,
+    account_ref: *const c_char,
+    group_id_hex: *const c_char,
+    parent_message_id: *const c_char,
+    available: *mut u8,
+    out: *mut *mut MarmotThreadReplyContext,
+) -> MarmotStatus {
+    ffi_guard(|| {
+        if !out.is_null() {
+            try_arg!(unsafe { crate::preflight_out_ptr(out) });
+        }
+        try_arg!(unsafe { write_out(available, 0) });
+        let client = try_arg!(unsafe { client_ref(client) });
+        let account_ref = try_arg!(unsafe { required_str(account_ref) });
+        let group_id_hex = try_arg!(unsafe { required_str(group_id_hex) });
+        let parent_message_id = try_arg!(unsafe { required_str(parent_message_id) });
+        let context = try_arg!(client.marmot.thread_reply_context(
+            &account_ref,
+            &group_id_hex,
+            &parent_message_id,
+        ).map_err(|err| status_from_error(&err)));
+        if let Some(context) = context {
+            if !out.is_null() {
+                unsafe { out.write(boxed(MarmotThreadReplyContext {
+                    root_message_id_hex: owned_c_string(context.root_message_id),
+                    root_author: owned_c_string(context.root_author),
+                    parent_author: owned_c_string(context.parent_author),
+                    root_kind: context.root_kind,
+                    parent_kind: context.parent_kind,
+                })) };
+            }
+            unsafe { available.write(1) };
+        }
+        MarmotStatus::Ok
+    })
+}
+
+/// Free a thread reply context. NULL is a no-op.
+///
+/// # Safety
+/// `ptr` must be NULL or an unfreed pointer returned by this library.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn marmot_thread_reply_context_free(ptr: *mut MarmotThreadReplyContext) {
+    crate::memory::free_guard(|| unsafe { crate::memory::free_boxed(ptr) });
+}
