+impl crate::MarmotApp {
+    pub(crate) fn thread_reply_context(
+        &self,
+        label: &str,
+        group_id_hex: &str,
+        parent_message_id: &str,
+    ) -> Result<Option<crate::ThreadReplyContext>, AppError> {
+        self.ensure_account_state(label)?;
+        let storage = self.account_storage(label)?.app_storage();
+        let placement = match thread_placement(&storage, group_id_hex, parent_message_id) {
+            Ok(placement) => placement,
+            Err(AppError::InvalidAppMessagePayload(_)) => return Ok(None),
+            Err(error) => return Err(error),
+        };
+        Ok(Some(crate::ThreadReplyContext {
+            root_message_id: placement.root_message_id,
+            root_kind: placement.root_kind,
+            root_author: placement.root_author,
+            parent_kind: placement.parent_kind,
+            parent_author: placement.parent_author,
+        }))
+    }
+}
