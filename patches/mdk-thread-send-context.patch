+/// Local root and direct-parent evidence for the thread placement tags.
+#[repr(C)]
+pub struct MarmotThreadReplyContext {
+    pub root_message_id_hex: *mut c_char,
+    pub root_author: *mut c_char,
+    pub parent_author: *mut c_char,
+    pub root_kind: u64,
+    pub parent_kind: u64,
+}
+
+impl CFree for MarmotThreadReplyContext {
+    unsafe fn free_in_place(&mut self) {
+        unsafe {
+            crate::memory::free_c_string(self.root_message_id_hex);
+            crate::memory::free_c_string(self.root_author);
+            crate::memory::free_c_string(self.parent_author);
+        }
+    }
+}
