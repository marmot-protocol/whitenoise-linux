+#[test]
+fn legacy_polls_keep_thread_root() {
+    let store = SqliteAccountStorage::in_memory().unwrap().app_storage();
+    let root = chat("root", "alice", 1, "parent");
+    let group = &root.group_id_hex;
+    store.record_app_event(&root).unwrap();
+
+    let standalone = poll("standalone", "alice", 2);
+    store.record_app_event(&standalone).unwrap();
+    assert!(
+        store
+            .timeline_message(group, "standalone")
+            .unwrap()
+            .unwrap()
+            .thread
+            .is_none()
+    );
+
+    for (id, parent, canonical) in [
+        ("old", "root", false),
+        ("nested", "old", false),
+        ("new", "nested", true),
+    ] {
+        let mut message = poll(id, "bob", 3);
+        message.tags.push(vec!["e".into(), parent.into()]);
+        message.tags.push(vec!["q".into(), "standalone".into()]);
+        if canonical {
+            message.tags.push(vec!["E".into(), "root".into()]);
+        }
+        store.record_app_event(&message).unwrap();
+        let row = store.timeline_message(group, id).unwrap().unwrap();
+        let thread = row.thread.unwrap();
+        assert_eq!(thread.root_message_id_hex, "root");
+        assert_eq!(thread.parent_message_id_hex, parent);
+        assert_eq!(row.reply_to_message_id_hex.as_deref(), Some("standalone"));
+    }
+}
