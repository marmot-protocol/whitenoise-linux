diff --git i/crates/marmot-markdown/odin/fltused_windows.odin w/crates/marmot-markdown/odin/fltused_windows.odin
new file mode 100644
--- /dev/null
+++ w/crates/marmot-markdown/odin/fltused_windows.odin
@@ -0,0 +1,11 @@
+#+build windows
+package markdown
+
+// MSVC's "this object uses floating point" marker. LLVM references it from
+// every Windows object with float code and the MSVC CRT defines it; a
+// MinGW link has no CRT definition. Built only for MinGW cross builds.
+// Not exported: @(export) would add an /EXPORT directive naming _fltused.
+when #config(MARMOT_MARKDOWN_MINGW, false) {
+	@(require, linkage = "strong", link_name = "_fltused")
+	_fltused: i32 = 0x9875
+}
