+async fn forget_group_local(
+    client: &mut AppClient,
+    group_id: &GroupId,
+    solo_only: bool,
+) -> Result<bool, AppError> {
+    if solo_only {
+        if !client.runtime.ensure_group_hydrated(group_id)? {
+            return Err(AppError::UnknownGroup(hex::encode(group_id.as_slice())));
+        }
+        let local_id = client.adapter.account_id();
+        let roster = client.runtime.canonical_group_membership(group_id)?;
+        if roster.member_leaves.is_empty()
+            || roster.member_leaves.iter().any(|leaf| &leaf.member != local_id)
+        {
+            return Ok(false);
+        }
+    }
+    client.forget_group_local(group_id).await
+}
