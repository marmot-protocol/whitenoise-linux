+struct Credentials {
+    keys: Option<Keys>,
+    remote: Option<PublicKey>,
+    user: Option<PublicKey>,
+    relays: Vec<RelayUrl>,
+    uri: String,
+    secret: Option<Zeroizing<String>>,
+    client_pairing: bool,
+    name: String,
+    verified: bool,
+}
+impl Drop for Credentials {
+    fn drop(&mut self) {
+        self.uri.zeroize();
+    }
+}
