+        "restored user identity must remain pinned"
+    );
+    assert!(wrong_user.is_null());
+    drop(mismatched);
+    let session_a = Session::new(client, &export_a);
+    assert_eq!(session_a.connect(), account_a);
+    session_a.register(client, &account_a);
