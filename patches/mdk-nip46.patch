+        );
+        assert!(
+            evidence
+                .signed
+                .iter()
+                .any(|event| event.kind == Kind::from(30443)),
+            "native keypackage must cross NIP46"
+        );
+        assert!(
+            evidence
+                .signed
+                .iter()
+                .any(|event| event.kind == Kind::InboxRelays),
+            "missing inbox must bootstrap through NIP46"
+        );
