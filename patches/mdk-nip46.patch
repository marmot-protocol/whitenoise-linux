+        assert!(
+            !completed.load(Ordering::SeqCst),
+            "spoofed pairing completed connect"
+        );
+        assert_ne!(session_b.state()["state"], "ready");
+        runtime.block_on(fixture_b.pairing.send(Pairing {
+            client: pairing_client,
+            secret: pairing_secret,
