+            descriptor["remote_signer_public_key"],
+            fixture.bunker.public_key().to_hex()
+        );
+        assert_eq!(
+            descriptor["relays"],
+            json!([expected_relay]),
+            "switch_relays must persist only this session's replacement transport"
