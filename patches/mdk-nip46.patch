+    fixture_a.controls.offline.store(false, Ordering::SeqCst);
+    drop(pending_a);
+    println!(
+        "PASS cold restart reopens encrypted account databases; offline signer does not block local/other remote accounts"
+    );
+    let mut wrong_pin = export_a.clone();
