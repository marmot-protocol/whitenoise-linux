@@ -0,0 +1,113 @@
+//! Explicit process-wide SOCKS5 routing. HTTP keeps its validated DNS pins;
+//! relay hostnames are resolved by the proxy through the SDK's SOCKS5 transport.
+
+use std::net::SocketAddr;
+
+use nostr_sdk::prelude::{Client, ClientBuilder, Error};
+use nostr_sdk::transport::websocket::{WebSocketSink, WebSocketStream, WebSocketTransport};
+
+pub(crate) const CONFIG_ERROR: &str = "WN_SOCKS5_PROXY must be a numeric IP address and nonzero port (127.0.0.1:9050 or [::1]:9050); SOCKS5 authentication is not supported";
+
+pub(crate) fn socks5_proxy() -> Result<Option<SocketAddr>, &'static str> {
+    match std::env::var("WN_SOCKS5_PROXY") {
+        Err(std::env::VarError::NotPresent) => Ok(None),
+        Ok(value) if value.is_empty() => Ok(None),
+        Ok(value) => parse_proxy(&value).map(Some),
+        Err(std::env::VarError::NotUnicode(_)) => Err(CONFIG_ERROR),
+    }
+}
+
+fn parse_proxy(value: &str) -> Result<SocketAddr, &'static str> {
+    value
+        .parse::<SocketAddr>()
+        .ok()
+        .filter(|addr| addr.port() != 0)
+        .ok_or(CONFIG_ERROR)
+}
+
+pub(crate) fn config_error(detail: &'static str) -> crate::AppError {
+    std::io::Error::new(std::io::ErrorKind::InvalidInput, detail).into()
+}
+
+pub(crate) fn nostr_builder() -> ClientBuilder {
+    let builder = Client::builder();
+    match socks5_proxy() {
+        Ok(Some(addr)) => builder.proxy(nostr_sdk::proxy::Proxy::all(addr)),
+        Ok(None) => builder,
+        // Legacy infallible constructors must never silently dial directly.
+        // Production open reports this configuration error before construction.
+        Err(detail) => builder.websocket_transport(BlockedTransport(detail)),
+    }
+}
+
+#[derive(Debug)]
+struct BlockedTransport(&'static str);
+
+impl WebSocketTransport for BlockedTransport {
+    fn support_ping(&self) -> bool {
+        false
+    }
+
+    fn connect<'a>(
+        &'a self,
+        _url: &'a nostr_sdk::prelude::Url,
+        _proxy: Option<SocketAddr>,
+    ) -> futures::future::BoxFuture<'a, Result<(WebSocketSink, WebSocketStream), Error>> {
+        Box::pin(async move {
+            Err(Error::transport(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                self.0,
+            )))
+        })
+    }
+}
+
+pub(crate) fn http_builder(
+    builder: reqwest::ClientBuilder,
+) -> Result<reqwest::ClientBuilder, &'static str> {
+    // Remove explicit and environment proxies first: NO_PROXY must not bypass
+    // the chosen proxy, and ALL_PROXY must not replace it.
+    let builder = builder.no_proxy();
+    match socks5_proxy()? {
+        Some(addr) => {
+            // socks5h would ignore resolve_to_addrs and allow proxy-side DNS
+            // rebinding into private services. socks5 sends the vetted IP while
+            // reqwest retains the original URL for TLS/SNI and the Host header.
+            let proxy =
+                reqwest::Proxy::all(format!("socks5://{addr}")).map_err(|_| CONFIG_ERROR)?;
+            Ok(builder.proxy(proxy))
+        }
+        None => Ok(builder),
+    }
+}
+
+pub(crate) fn require_direct_transport() -> Result<(), crate::AppError> {
+    if socks5_proxy().map_err(config_error)?.is_some() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::Unsupported,
+            "QUIC agent previews are unavailable while WN_SOCKS5_PROXY is enabled; SOCKS5 TCP routing cannot carry QUIC",
+        )
+        .into());
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn numeric_proxy_addresses_only() {
+        assert!(parse_proxy("127.0.0.1:9050").is_ok());
+        assert!(parse_proxy("[::1]:9050").is_ok());
+        for value in [
+            "localhost:9050",
+            "socks5://127.0.0.1:9050",
+            "user:pass@127.0.0.1:9050",
+            "127.0.0.1:0",
+            " 127.0.0.1:9050",
+        ] {
+            assert!(parse_proxy(value).is_err());
+        }
+    }
+}
