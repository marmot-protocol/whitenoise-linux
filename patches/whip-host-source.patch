+			   pv.mount.fb_w > 0 &&
+			   pv.mount.fb_h > 0 {wanted = job; break}
+		}
+		if wanted == nil {return}
+		wanted.worker = thread.create_and_start_with_poly_data(wanted, snapshot_decode, context)
+		if wanted.worker == nil {fail(app, "cannot start snapshot decoder"); return}
+		active += 1
+	}
