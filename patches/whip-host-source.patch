+@(private)
+snapshot_work :: proc(app: ^App) {
+	active := 0
+	index := 0
+	for index < len(app.snapshot_jobs) {
+		job := app.snapshot_jobs[index]
+		if job.worker != nil && !thread.is_done(job.worker) {active += 1; index += 1; continue}
+		if job.worker == nil && job.pane != 0 {index += 1; continue}
+		if job.worker !=
+		   nil {thread.join(job.worker); thread.destroy(job.worker); job.worker = nil}
+		if pv := app.panes[job.pane]; pv != nil && pv.snapshot_job == job {
+			pv.snapshot_job = nil
+			if job.result != .Success {fail(app, "bad snapshot from server"); return}
+			snapshot_install(app, pv, job.term)
+			job.term = nil
+		}
+		snapshot_release(job)
+		app.snapshot_jobs[index] = app.snapshot_jobs[len(app.snapshot_jobs) - 1]
+		resize(&app.snapshot_jobs, len(app.snapshot_jobs) - 1)
+	}
+	for active < 2 {
+		wanted: ^Snapshot_Job
+		for job in app.snapshot_jobs {
+			if job.worker != nil || job.pane == 0 {continue}
+			if wanted == nil {wanted = job}
+			pv := app.panes[job.pane]
+			if pv != nil &&
