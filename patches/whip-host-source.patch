+// The observer reads one server stream. A mounted pane owns its terminal;
+// the observer borrows it for titles and notice callbacks.
+@(private)
+source_attach :: proc(app: ^App) {
+	if app.target.kind != .Pane || app.source.source != nil {
+		fail(app, "a shared source requires a single bound pane")
+		return
+	}
+	layout: [dynamic]u8
+	defer delete(layout)
+	model.encode(&app.source.session, &layout)
+	apply_frame(app, {msg = .Layout, payload = layout[:]})
+	if pv := app.source.panes[app.target.pane]; pv != nil && pv.app_pane {
+		clear(&layout)
+		proto.put_u32(&layout, 1)
+		proto.put_u32(&layout, u32(pv.id))
+		proto.put_str16(&layout, pv.app_title)
+		apply_frame(app, {msg = .App_Panes, payload = layout[:]})
+		if len(pv.app_frame) > 0 {apply_frame(app, {msg = .App_Frame, payload = pv.app_frame})}
+	} else {
+		source_adopt(app, app.target.pane)
+	}
+	if app.running {context = app.source.ctx; append(&app.source.followers, app)}
+}
+
+@(private)
+source_adopt :: proc(app: ^App, pane: proto.Pane_Id) {
+	source := app.source.panes[pane]
+	if source == nil {
+		context = app.source.ctx
+		source = new(Pane_View)
+		source.id = pane
+		view_init(&source.view)
+		source.view.look = &app.source.config.colors
+		app.source.panes[pane] = source
+	}
+	context = app.ctx
+	if source.mount != nil &&
+	   source.mount != app {fail(app, "a terminal already has a mounted owner"); return}
+	source.mount = app
+	if source.term == nil {return}
+	pv := app.panes[pane]
+	if pv != nil && pv.term == source.term {return}
+	if source.term_borrowed {fail(app, "a terminal already has a mounted owner"); return}
+	if pv == nil {
+		pv = new(Pane_View)
+		pv.id = pane
+		view_init(&pv.view)
+		pv.view.look = &app.config.colors
+		app.panes[pane] = pv
+	} else {
+		if app.search.handle != nil && app.search.pane == pane {search_close(app)}
+		pane_view_release_term(pv)
+	}
+	pv.term = source.term
+	source.term_borrowed = true
+	if pv.app_texture != 0 {gl.DeleteTextures(1, &pv.app_texture); pv.app_texture = 0}
+	delete(pv.app_title)
+	pv.app_title, pv.app_pane = "", false
+	pv.requested, pv.resizing = {}, false
+	pv.view.force_full = true
+	config.apply_colors(pv.term, app.config.colors)
+	app.force_draw = true
+}
+
+@(private)
+source_frame :: proc(app: ^App, frame: proto.Frame) {
+	// Queries repeat these payloads. Unchanged replies must not rebuild every
+	// mounted model or switch all GL contexts. Request-specific Pane_Info and
+	// View replies belong only to the connection that issued their command.
+	if frame.msg == .Layout || frame.msg == .App_Panes {
+		saved := frame.msg == .Layout ? &app.source_layout : &app.source_apps
+		if slice.equal(saved^[:], frame.payload) {return}
+		resize(saved, len(frame.payload))
+		copy(saved^[:], frame.payload)
+	}
+	if frame.msg == .Output || frame.msg == .Resized {
+		address := proto.Reader {
+			data = frame.payload,
+		}
+		if pv := app.panes[proto.Pane_Id(proto.get_u32(&address))];
+		   pv != nil && pv.snapshot_job != nil {return}
+	}
+	#partial switch frame.msg {
+	case .Layout, .Snapshot, .Output, .Resized, .App_Panes, .App_Frame:
+	case:
+		return
+	}
+	for follower in app.followers {
+		if !follower.running {continue}
+		context = follower.ctx
+		if frame.msg == .Output || frame.msg == .Resized {
+			apply_frame(follower, frame)
+			continue
+		}
+		state, ok := ui_state_save(follower)
+		if !ok {fail(follower, "cannot activate mounted renderer"); continue}
+		apply_frame(follower, frame)
+		ui_state_restore(state)
+	}
+}
+
+@(private)
+source_detach :: proc(app: ^App) {
+	if source := app.source; source != nil {
+		if pv := source.panes[app.target.pane]; pv != nil && pv.mount == app {pv.mount = nil}
+		for pane, pv in app.panes {
+			original := source.panes[pane]
+			if original == nil || !original.term_borrowed || original.term != pv.term {continue}
+			if pv.gesture != nil {
+				gh.selection_gesture_free(pv.gesture, pv.term)
+				pv.gesture = nil
+			}
+			original.term_borrowed = false
+			pv.term = nil
+		}
+		for follower, i in source.followers {
+			if follower != app {continue}
+			source.followers[i] = source.followers[len(source.followers) - 1]
+			resize(&source.followers, len(source.followers) - 1)
+			break
+		}
+		app.source = nil
+	}
+	for follower in app.followers {
+		follower.source = nil
+		for _, pv in follower.panes {
+			if pv.term != nil {gh.terminal_set(pv.term, .Userdata, follower)}
+		}
+		fail(follower, "terminal source disconnected")
+	}
+	delete(app.followers)
+	app.followers = nil
+	delete(app.source_layout)
+	delete(app.source_apps)
+}

