+/// C entry points `src/native.rs` links against.
+const EXPORTS: [&str; 3] = ["markdown_parse", "markdown_free", "markdown_classify"];
+
+/// Prefix every other defined global with `marmot_markdown.`. An Odin host
+/// links its own runtime under the same names, such as
+/// `runtime::default_random_generator_proc-.state-1827` and, on x86-64 Linux,
+/// the float16 builtins and `csbs$$N` constants that LTO partitioning
+/// exports. A static link of both would fail with duplicate definitions.
+fn rename_odin_symbols(archive: &Path, darwin: bool) {
+    let underscore = if darwin { "_" } else { "" };
+    let listing = Command::new(llvm_tool("llvm-nm"))
+        .args(["--defined-only", "--extern-only", "--format=just-symbols"])
+        .arg(archive)
+        .output()
+        .expect("run llvm-nm; install llvm-tools-preview");
+    assert!(listing.status.success(), "list Odin archive symbols");
+    let listing = String::from_utf8(listing.stdout).expect("UTF-8 Odin symbols");
+    // Archive listings head each member with `name:`.
+    let symbols: BTreeSet<&str> = listing
+        .lines()
+        .filter(|symbol| !symbol.is_empty() && !symbol.ends_with(':'))
+        .collect();
+    let mut objcopy = Command::new(llvm_tool("llvm-objcopy"));
+    for symbol in symbols {
+        let name = symbol.strip_prefix(underscore).unwrap_or(symbol);
+        if EXPORTS.contains(&name) {
+            continue;
+        }
+        objcopy.arg(format!(
+            "--redefine-sym={symbol}={underscore}marmot_markdown.{name}"
+        ));
+    }
+    run_native(objcopy.arg(archive));
+}
+
+/// The toolchain's llvm-tools copy, else one on PATH for toolchains without it.
+fn llvm_tool(name: &str) -> PathBuf {
+    let bundled = native_tools().join(format!("{name}{}", env::consts::EXE_SUFFIX));
+    if bundled.exists() {
+        bundled
+    } else {
+        PathBuf::from(name)
+    }
+}
