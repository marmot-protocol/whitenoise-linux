+void NewCommandMacro::_reset_() {
+  if (!baselineTaken) {
+    baselineCodes = _codes;
+    baselineReplacements = _replacements;
+    baselineTaken = true;
+  }
+  for (const auto& i : _codes) {
+    if (baselineCodes.count(i.first) == 0) MacroInfo::remove(i.first);
+  }
+  _codes = baselineCodes;
+  _replacements = baselineReplacements;
+  _errIfConflict = true;
+  _expansions = 0;
+}
