+void MacroInfo::remove(const std::string& name) {
+  auto it = _commands.find(name);
+  if (it == _commands.end()) return;
+  delete it->second;
+  _commands.erase(it);
+}
+
 void MacroInfo::_free_() {
   for (const auto& i : _commands) delete i.second;
 }
