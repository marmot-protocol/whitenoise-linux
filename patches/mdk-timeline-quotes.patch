+#[test]
+fn explicit_body_quote_tracks_live_target_updates() {
+    let mut window = timeline_test_page(&[("comment", 20)], true, true);
+    let comment = &mut window.messages[0];
+    comment.kind = cgka_traits::NIP22_COMMENT_KIND;
+    comment.tags = vec![vec!["q".into(), "quote".into()]];
+    comment.reply_to_message_id_hex = Some("parent".into());
+
+    // This delta updates the quote but cannot add its off-page target.
+    let mut quote = timeline_test_record("quote", 30);
+    quote.plaintext = "edited quote".into();
+    let edit = projection_for(vec![quote]);
+    apply_projection_to_window(&mut window, &edit, 300, TimelineOrder::WallClock);
+    assert_eq!(timeline_ids(&window), vec!["comment"]);
+    assert_eq!(
+        window.messages[0].body_quote_preview.as_ref().unwrap().plaintext,
+        "edited quote"
+    );
+
+    let mut remove = projection_for(vec![]);
+    remove.timeline_changes.push(TimelineMessageChange::Remove {
+        message_id_hex: "quote".into(),
+        reason: crate::TimelineRemoveReason::Invalidated,
+    });
+    apply_projection_to_window(&mut window, &remove, 300, TimelineOrder::WallClock);
+    assert!(window.messages[0].body_quote_preview.is_none());
+}
