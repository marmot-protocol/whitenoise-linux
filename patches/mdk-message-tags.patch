+        assert_eq!(event.tags, tags);
+        let media = AppMessageIntent::Media {
+            attachments: vec![MediaAttachmentReference {
+                locators: vec![],
+                ciphertext_sha256: reference.clone(),
+                plaintext_sha256: reference.clone(),
+                nonce_hex: "11".repeat(12),
+                file_name: "sticker.png".into(),
+                media_type: "image/png".into(),
+                version: "encrypted-media-v2".into(),
+                source_epoch: 1,
+                dim: None,
+                thumbhash: None,
+            }],
+            caption: None,
+            message_tags: tags.clone(),
+        };
+        let event = build_inner_event(&media, &pk, 1).unwrap();
