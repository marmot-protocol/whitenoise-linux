FROM ubuntu:24.04
ARG ODIN_VERSION=dev-2026-09
ARG ODIN_SHA256=167c3e1d7056419dad2e04bb3bd98715b7ff286d4c125f3c5a5ee337c6254283
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang llvm lld cmake ninja-build pkg-config git curl ca-certificates \
    unzip zip xz-utils bzip2 tar file patch python3 python3-pip python3-venv \
    autoconf autoconf-archive automake libtool gettext gperf bison flex nasm yasm texinfo \
    libssl-dev libxml2-dev zlib1g-dev liblzma-dev libbz2-dev \
    gcc-aarch64-linux-gnu g++-aarch64-linux-gnu binutils-aarch64-linux-gnu \
    binutils-mingw-w64-x86-64 mingw-w64-tools \
    mmdebstrap patchelf qemu-user wine wine64 xvfb xauth libglib2.0-bin libwayland-bin \
    dotnet-sdk-8.0 openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/python && /opt/python/bin/pip install --no-cache-dir meson==1.9.1 mako==1.3.10 packaging==25.0
ENV PATH=/opt/python/bin:/opt/odin:/root/.cargo/bin:/usr/lib/llvm-18/bin:$PATH
RUN mkdir /opt/odin && curl -fsSL "https://github.com/odin-lang/Odin/releases/download/${ODIN_VERSION}/odin-linux-amd64-${ODIN_VERSION}.tar.gz" -o /tmp/odin.tar.gz \
    && echo "$ODIN_SHA256  /tmp/odin.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/odin.tar.gz -C /opt/odin --strip-components=1 \
    && chmod +x /opt/odin/odin && rm /tmp/odin.tar.gz
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable
WORKDIR /work
ARG BUN_VERSION=1.3.10
ARG BUN_SHA256=f57bc0187e39623de716ba3a389fda5486b2d7be7131a980ba54dc7b733d2e08
RUN curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" -o /tmp/bun.zip \
    && echo "$BUN_SHA256  /tmp/bun.zip" | sha256sum -c - \
    && unzip -q /tmp/bun.zip -d /opt \
    && ln -s /opt/bun-linux-x64/bun /usr/local/bin/bun && rm /tmp/bun.zip
# Velopack signs Windows binaries through a command template; jsign is the
# Linux-side Authenticode signer (PKCS#12, cloud HSMs, Azure Artifact Signing).
ARG JSIGN_VERSION=7.5
ARG JSIGN_SHA256=602a51c3545a6dc4fb99bd2ea7152b26d1345916d0c93ddfbd5936cb735af91c
RUN mkdir -p /opt/jsign && curl -fsSL "https://github.com/ebourg/jsign/releases/download/${JSIGN_VERSION}/jsign-${JSIGN_VERSION}.jar" -o /opt/jsign/jsign.jar \
    && echo "$JSIGN_SHA256  /opt/jsign/jsign.jar" | sha256sum -c -
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
ENTRYPOINT ["bash", "scripts/cross-build.sh"]
