import { MentionInboxItem, Palette, Theme } from "../tokens.slint";
import { MentionsInbox } from "../main-pane/mentions-inbox.slint";

// The title bar's "@" button, opening the mentions-inbox popover.
export component MentionsIcon inherits Rectangle {
    in property <[MentionInboxItem]> mention-items;
    in property <bool> mentions-loading: false;
    // Bumped (not toggled) by the parent to open the popover from the command
    // palette or a global shortcut, mirroring the click path below.
    in property <int> open-requested: 0;
    callback mentions-inbox-opened();
    callback mention-inbox-item-selected(string, string);

    width: 30px;
    height: 30px;
    background: mention-inbox-touch.has-hover ? Palette.hover : transparent;
    border-radius: (6px) * Theme.r-scale;
    animate background { duration: Theme.hover-dur; }
    accessible-role: button;
    accessible-label: @tr("Mentions inbox");
    accessible-action-default => { root.activate(); }

    function activate() {
        root.mentions-inbox-opened();
        mention-inbox.open();
    }

    changed open-requested => {
        root.activate();
    }

    mention-inbox-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activate();
        }

        Text {
            text: "@";
            color: mention-inbox-touch.has-hover ? Palette.mint : Palette.text-mid;
            font-family: Theme.font;
            font-size: Theme.fs(12px, 17px);
            font-weight: 800;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    // Zero-size FocusScope: joins the Tab chain without taking pointer
    // events. Mirrors ui/main-pane/chat-header.slint's icon buttons.
    mention-inbox-fs := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activate();
                return accept;
            }
            return reject;
        }
    }

    if mention-inbox-fs.has-focus: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: (5px) * Theme.r-scale;
        border-width: 2px;
        border-color: Palette.mint;
    }

    mention-inbox := MentionsInbox {
        x: parent.width;
        y: 0px;
        items: root.mention-items;
        loading: root.mentions-loading;
        selected(group-id, message-id) => {
            root.mention-inbox-item-selected(group-id, message-id);
        }
    }
}
