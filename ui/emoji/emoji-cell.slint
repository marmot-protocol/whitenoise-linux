import { Palette, Theme } from "../tokens.slint";

// One emoji tile in the picker grid: hover highlight + sprite-sheet glyph
// with a slight pop on hover. Stays always-mounted with `visible`/`enabled`
// gating (an `if`-guarded mount used to race the first user click), so the
// parent drives `active` instead of conditionally instantiating the cell.
export component EmojiCell inherits Rectangle {
    in property <bool> active;
    in property <image> sprite;
    in property <int> tile;
    in property <int> clip-x;
    in property <int> clip-y;
    in property <string> label;
    // Keyboard selection — highlighted exactly like hover so arrow-key/Tab
    // users get the same visible affordance mouse users get (mirrors
    // MenuItem.selected).
    in property <bool> selected: false;
    callback picked();

    property <bool> highlighted: cell.has-hover || root.selected;

    visible: root.active;
    border-radius: (4px) * Theme.r-scale;
    background: root.highlighted ? Palette.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        if (root.active) {
            root.picked();
        }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        visible: root.active;
        source: root.sprite;
        source-clip-x: root.clip-x;
        source-clip-y: root.clip-y;
        source-clip-width: root.tile;
        source-clip-height: root.tile;
        // Slight pop on hover/selection so the glyph responds along with the
        // cell highlight.
        width: root.highlighted ? 26px : 22px;
        height: root.highlighted ? 26px : 22px;
        animate width, height {
            duration: 80ms;
            easing: ease-out;
        }
        image-fit: contain;
    }

    cell := TouchArea {
        enabled: root.active;
        clicked => {
            if (root.active) {
                root.picked();
            }
        }
    }
}
