import { Palette, Theme, Contact } from "../tokens.slint";
import { CheckMark } from "../icons/check-mark.slint";
import { Avatar } from "../primitives/avatar.slint";

// Dense directory row: one 40px line (avatar · name · check), with the npub
// fading in right-aligned on hover/selection instead of taking a second line.
export component ContactListItem inherits Rectangle {
    callback clicked;
    in property <Contact> data;
    in property <bool> selected: false;

    // Collapsed-strip mode: avatar (with its online dot) only.
    in property <bool> compact: false;

    height: 40px;
    background: root.selected ? Palette.selected : (touch.has-hover ? Palette.hover : transparent);
    border-radius: (8px) * Theme.r-scale;
    border-width: Theme.selected-inverts-text && root.selected ? Theme.border-w : (root.selected && !Theme.selected-inverts-text ? 1px : 0px);
    border-color: root.selected && !Theme.selected-inverts-text ? Palette.mint-glow : Palette.border;
    animate background, border-color {
        duration: 140ms;
        easing: ease-out;
    }

    // Mint accent bar — only in normal mode; in retro the yellow bar would vanish
    // against the yellow selected tile.
    if !Theme.pixel-select-marker: Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? 22px : 0px;
        y: (parent.height - self.height) / 2;
        background: Palette.mint;
        border-radius: (1.5px) * Theme.r-scale;
        drop-shadow-blur: root.selected ? 6px : 0px;
        drop-shadow-color: Palette.mint-glow;
        opacity: root.selected ? 1.0 : 0.0;
        animate height {
            duration: 220ms;
            easing: ease-in-out;
        }
        animate opacity {
            duration: 160ms;
            easing: ease-out;
        }
    }
    // Retro selection chevron — slides in from outside.
    if Theme.pixel-select-marker: Text {
        x: root.selected ? 2px : -14px;
        y: (parent.height - self.height) / 2;
        text: "▶";
        color: Palette.on-accent;
        font-size: Theme.fs(14px, 18px);
        font-family: Theme.font;
        vertical-alignment: center;
        opacity: root.selected ? 1.0 : 0.0;
        animate x {
            duration: 140ms;
            easing: ease-out;
        }
        animate opacity { duration: Theme.hover-dur; }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 28px;
            Avatar {
                size: 28px;
                y: (parent.height - self.height) / 2;
                initials: root.data.av-initials;
                color-a: root.data.av-a;
                color-b: root.data.av-b;
                picture: root.data.picture;
                has-picture: root.data.has-picture;
                a11y-label: root.data.name;
                font-size: Theme.fs(10px, 14px);
            }

            if root.data.online: Rectangle {
                x: parent.width - 9px;
                y: parent.height - 15px;
                width: 9px;
                height: 9px;
                border-radius: (4.5px) * Theme.r-scale;
                background: Palette.mint-dim;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: (4.5px) * Theme.r-scale;
                    border-width: 1.5px;
                    border-color: Palette.bg;
                }
            }
        }

        if !root.compact: Text {
            text: root.data.name;
            // Cream on yellow is invisible in retro — switch to dark indigo when selected.
            color: Theme.selected-inverts-text && root.selected ? Palette.on-accent : Palette.text-hi;
            font-size: Theme.fs(13px, 16px);
            font-weight: 700;
            font-family: Theme.font;
            vertical-alignment: center;
            overflow: elide;
        }

        if !root.compact && root.data.verified: CheckMark {
            // Yellow check on yellow tile is invisible — go indigo when selected in retro.
            stroke: Theme.selected-inverts-text && root.selected ? Palette.on-accent : Palette.mint;
            double: false;
            y: (parent.height - self.height) / 2;
        }

        if !root.compact: Text {
            text: root.data.npub-short;
            color: Theme.selected-inverts-text && root.selected ? Palette.on-accent : Palette.text-vlo;
            font-size: Theme.fs(10px, 14px);
            font-family: Theme.font;
            vertical-alignment: center;
            horizontal-alignment: right;
            horizontal-stretch: 1;
            overflow: elide;
            opacity: root.selected || touch.has-hover ? 1.0 : 0.0;
            animate opacity {
                duration: 140ms;
                easing: ease-out;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
