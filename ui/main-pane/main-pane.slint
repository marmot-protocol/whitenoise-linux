import { Palette, ChatMeta } from "../tokens.slint";
import { AppState } from "../shell/app-state.slint";
import { MessagesArea } from "../messages/messages.slint";
import { ChatHeader } from "chat-header.slint";
import { ChatSearchBar } from "chat-search-bar.slint";
import { ChatRequestBanner } from "chat-request-banner.slint";
import { SessionDivider } from "session-divider.slint";
import { Composer } from "composer.slint";
import { MentionPicker } from "mention-picker.slint";
import { GroupMembersPanel } from "group-members-panel.slint";

// The open-conversation pane: header, message scroll, composer, and the
// group-members side panel. Reads AppState directly (per the AGENTS.md rule:
// shell/pages read the global; leaf primitives stay pure-props) — the shell
// mounts it with layout geometry only.
export component MainPane inherits Rectangle {
    // The open chat's row — the single indexed lookup the children share.
    property <ChatMeta> chat: AppState.chats[AppState.active-chat];
    // Centred reading measure: proportional to the thread pane (78%, floored
    // at 760px) instead of the old fixed body-era 760px column. Computed
    // from the root minus the members panel so it never feeds back into the
    // column layout's own sizing (binding loop).
    property <length> thread-w: root.width - members-wrap.width;
    property <length> centered-col: min(root.thread-w, max(760px, root.thread-w * 0.78));

    horizontal-stretch: 1;
    // Sits inside the shell's conversation card, so it takes the elevated card
    // surface rather than the canvas bg.
    background: Palette.card;

    HorizontalLayout {
        spacing: 0;
        vertical-stretch: 1;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0;

            ChatHeader { }

            // In-conversation search. Always mounted, height-gated by
            // msg-search-open inside the component (an `if`-mounted TouchArea
            // swallows its first click).
            ChatSearchBar { }

            if root.chat.is-chat-request: ChatRequestBanner { }

            SessionDivider {
                label: root.chat.is-chat-request ? @tr("CHAT REQUEST") + " · " + root.chat.session-time : "MLS · " + @tr("SESSION ESTABLISHED") + " · " + root.chat.session-time;
            }

            // Full-width thread (default), or the opt-in centred reading
            // measure (Appearance → Centred conversation).
            if !AppState.shell-centered: MessagesArea {
                vertical-stretch: 1;
                available-w: parent.width;
            }
            if AppState.shell-centered: Rectangle {
                vertical-stretch: 1;
                HorizontalLayout {
                    alignment: center;
                    MessagesArea {
                        width: root.centered-col;
                        available-w: root.centered-col;
                    }
                }
            }

            // Keep the composer aligned with the thread above: when the
            // centred reading measure is on, constrain the input pill to the
            // same 760px column and centre it; otherwise it fills the pane.
            HorizontalLayout {
                alignment: AppState.shell-centered ? center : stretch;
                composer := Composer {
                    min-width: AppState.shell-centered ? root.centered-col : 0px;
                    max-width: AppState.shell-centered ? root.centered-col : 100000px;
                }
            }
        }

        // Always mounted; open/close animates the clipped wrapper width so
        // the panel slides in from the right edge instead of popping.
        members-wrap := Rectangle {
            property <bool> open: AppState.chat-can-show-members && AppState.show-chat-members;
            width: self.open ? 320px : 0px;
            animate width {
                duration: 170ms;
                easing: ease-in-out;
            }
            clip: true;
            GroupMembersPanel {
                x: parent.width - 320px;
                width: 320px;
                height: parent.height;
            }
        }
    }

    // Mention autocomplete popup, floated just above the composer's text field.
    // A direct child of the root Rectangle (not the layout) so it can be
    // free-positioned and overlay the messages area.
    if AppState.mention-active && AppState.mention-candidates.length > 0: MentionPicker {
        candidates: AppState.mention-candidates;
        selected: AppState.mention-selected;
        anchor-x: composer.absolute-position.x - root.absolute-position.x + 46px;
        container-width: composer.absolute-position.x - root.absolute-position.x + composer.width;
        y: composer.absolute-position.y - root.absolute-position.y - self.height - 2px;
        choose(i) => {
            AppState.mention-choose(i);
        }
    }
}
