import { Palette, Theme } from "../tokens.slint";
import { MenuItem } from "../primitives/menu-item.slint";
import { AppState } from "../shell/app-state.slint";

// Per-member admin action menu, opened from a member row's "⋯" button. Mounted
// full-window (like MessageContextMenu) so the invisible backdrop catches
// outside clicks and the panel can sit at the anchor, clamped inside the
// window. Items are gated by the same can-* flags the row carries; each closes
// the menu and calls the AppState request-* function, which arms the existing
// admin-confirm modal.
export component GroupMemberMenu inherits Rectangle {
    function promote() {
        AppState.member-menu-open = false;
        AppState.request-promote-admin(AppState.member-menu-id, AppState.member-menu-name);
    }
    function demote() {
        AppState.member-menu-open = false;
        AppState.request-demote-admin(AppState.member-menu-id, AppState.member-menu-name);
    }
    function self-demote() {
        AppState.member-menu-open = false;
        AppState.request-self-demote-admin(AppState.member-menu-name);
    }
    function transfer() {
        AppState.member-menu-open = false;
        AppState.request-transfer-ownership(AppState.member-menu-id, AppState.member-menu-name);
    }
    function remove() {
        AppState.member-menu-open = false;
        AppState.request-remove-member(AppState.member-menu-id, AppState.member-menu-name);
    }

    // Keyboard navigation. Every row is independently gated, so indices are
    // derived by cascading the shown-count of the rows before each one — the
    // first visible row always lands on 0, matching the contiguous
    // [0, count-1] scheme MessageContextMenu / ChatContextMenu use.
    property <int> n-promote: AppState.member-menu-can-promote ? 1 : 0;
    property <int> n-transfer: AppState.member-menu-can-transfer ? 1 : 0;
    property <int> n-demote: AppState.member-menu-can-demote ? 1 : 0;
    property <int> n-self-demote: AppState.member-menu-can-self-demote ? 1 : 0;
    property <int> n-remove: AppState.member-menu-can-remove ? 1 : 0;
    property <int> promote-idx: AppState.member-menu-can-promote ? 0 : -1;
    property <int> transfer-idx: AppState.member-menu-can-transfer ? root.n-promote : -1;
    property <int> demote-idx: AppState.member-menu-can-demote ? root.n-promote + root.n-transfer : -1;
    property <int> self-demote-idx: AppState.member-menu-can-self-demote ? root.n-promote + root.n-transfer + root.n-demote : -1;
    property <int> remove-idx: AppState.member-menu-can-remove ? root.n-promote + root.n-transfer + root.n-demote + root.n-self-demote : -1;
    property <int> item-count: root.n-promote + root.n-transfer + root.n-demote + root.n-self-demote + root.n-remove;
    property <int> selected-index: 0;

    function move-selection(delta: int) {
        root.selected-index = min(max(0, root.selected-index + delta), root.item-count - 1);
    }
    // Tab wraps around the list rather than escaping the menu.
    function wrap-selection(delta: int) {
        if (root.selected-index + delta < 0) {
            root.selected-index = root.item-count - 1;
        } else if (root.selected-index + delta >= root.item-count) {
            root.selected-index = 0;
        } else {
            root.selected-index = root.selected-index + delta;
        }
    }
    function activate-selected() {
        if (AppState.member-menu-can-promote && root.selected-index == root.promote-idx) {
            root.promote();
        } else if (AppState.member-menu-can-transfer && root.selected-index == root.transfer-idx) {
            root.transfer();
        } else if (AppState.member-menu-can-demote && root.selected-index == root.demote-idx) {
            root.demote();
        } else if (AppState.member-menu-can-self-demote && root.selected-index == root.self-demote-idx) {
            root.self-demote();
        } else if (AppState.member-menu-can-remove && root.selected-index == root.remove-idx) {
            root.remove();
        }
    }

    // Invisible backdrop — dismisses on any click outside the panel.
    TouchArea {
        clicked => {
            AppState.member-menu-open = false;
        }
    }

    // Clamp the panel inside the window with a small inset. The anchor point
    // (top-left of the panel, in window coords) comes from AppState.
    property <length> inset: 8px;
    property <length> px: min(max(root.inset, AppState.member-menu-x), root.width - panel.width - root.inset);
    property <length> py: min(max(root.inset, AppState.member-menu-y), root.height - panel.height - root.inset);

    // Open animation — flip-after-mount, matching MessageContextMenu.
    property <bool> opened: false;
    init => {
        root.opened = true;
        root.selected-index = 0;
        keys.focus();
    }

    panel := Rectangle {
        x: root.px;
        y: root.py + (root.opened ? 0px : -4px);
        width: max(184px, col.preferred-width);
        height: col.preferred-height;
        opacity: root.opened ? 1.0 : 0.0;
        animate opacity {
            duration: Theme.transition-dur;
            easing: ease-out;
        }
        animate y {
            duration: Theme.transition-dur;
            easing: ease-out;
        }
        background: Palette.elevated;
        border-radius: (10px) * Theme.r-scale;
        border-width: Theme.border-w;
        border-color: Palette.elevated-border;
        drop-shadow-color: Theme.hard-shadow ? Palette.shadow : Palette.shadow-popover;
        drop-shadow-offset-x: Theme.hard-shadow ? 2px : 0px;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: Theme.hard-shadow ? 0px : 14px;

        // Wrap the content so any click the items don't claim is swallowed
        // (nested item TouchAreas still win the hit-test).
        TouchArea {
            col := VerticalLayout {
                padding: 4px;
                spacing: 1px;

                // Header naming the member this menu acts on.
                Rectangle {
                    height: 26px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 16px;
                        Text {
                            text: AppState.member-menu-name;
                            color: Palette.text-lo;
                            font-size: Theme.fs(11px, 14px);
                            font-family: Theme.font;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border-2;
                }

                MenuItem {
                    glyph: "★";
                    label: @tr("Make admin");
                    shown: AppState.member-menu-can-promote;
                    selected: root.selected-index == root.promote-idx;
                    activated => {
                        root.promote();
                    }
                    hovered => {
                        root.selected-index = root.promote-idx;
                    }
                }

                MenuItem {
                    glyph: "⇄";
                    label: @tr("Transfer ownership");
                    shown: AppState.member-menu-can-transfer;
                    selected: root.selected-index == root.transfer-idx;
                    activated => {
                        root.transfer();
                    }
                    hovered => {
                        root.selected-index = root.transfer-idx;
                    }
                }

                MenuItem {
                    glyph: "☆";
                    label: @tr("Remove admin");
                    shown: AppState.member-menu-can-demote;
                    selected: root.selected-index == root.demote-idx;
                    activated => {
                        root.demote();
                    }
                    hovered => {
                        root.selected-index = root.demote-idx;
                    }
                }

                MenuItem {
                    glyph: "↩";
                    label: @tr("Step down");
                    shown: AppState.member-menu-can-self-demote;
                    selected: root.selected-index == root.self-demote-idx;
                    activated => {
                        root.self-demote();
                    }
                    hovered => {
                        root.selected-index = root.self-demote-idx;
                    }
                }

                MenuItem {
                    glyph: "⊘";
                    label: @tr("Remove from group");
                    shown: AppState.member-menu-can-remove;
                    selected: root.selected-index == root.remove-idx;
                    activated => {
                        root.remove();
                    }
                    hovered => {
                        root.selected-index = root.remove-idx;
                    }
                }
            }
        }
    }

    // Keyboard handling — focused on mount so keys land here. Esc dismisses;
    // Up/Down (and Tab/Backtab) move the selection, Home/End jump to the
    // first/last item; Return/Enter activates.
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                AppState.member-menu-open = false;
                return accept;
            }
            if (e.text == Key.UpArrow) {
                root.move-selection(-1);
                return accept;
            }
            if (e.text == Key.DownArrow) {
                root.move-selection(1);
                return accept;
            }
            if (e.text == Key.Home) {
                root.selected-index = 0;
                return accept;
            }
            if (e.text == Key.End) {
                root.selected-index = root.item-count - 1;
                return accept;
            }
            if (e.text == Key.Tab) {
                root.wrap-selection(1);
                return accept;
            }
            if (e.text == Key.Backtab) {
                root.wrap-selection(-1);
                return accept;
            }
            if (e.text == Key.Return) {
                root.activate-selected();
                return accept;
            }
            return reject;
        }
    }
}
