import { Palette } from "../tokens.slint";

// Keyboard activation + focus ring for any clickable element: a zero-size
// FocusScope joins the Tab chain (never stealing pointer focus — mirrors
// button.slint's `fs`), Enter/Space fire `activate`, and while focused a mint
// ring draws around the host's bounds. The root fills the host and is
// input-transparent (plain Rectangle, no TouchArea). `ring-inset` moves the
// ring inside (positive) for hosts that clip; the default rides just outside.
// Hosts that need accessibility-on-focus or extra keys (run-cell links, the
// reaction caret's arrow nav) keep their own FocusScope instead.
export component KeyActivate inherits Rectangle {
    in property <bool> key-enabled: true;
    in property <length> ring-radius: 11px;
    in property <length> ring-inset: -3px;
    out property <bool> focused: fs.has-focus;
    callback activate();

    fs := FocusScope {
        x: 0;
        y: 0;
        width: 0px;
        height: 0px;
        enabled: root.key-enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activate();
                return accept;
            }
            return reject;
        }
    }

    if fs.has-focus: Rectangle {
        x: root.ring-inset;
        y: root.ring-inset;
        width: parent.width - root.ring-inset * 2;
        height: parent.height - root.ring-inset * 2;
        background: transparent;
        border-radius: root.ring-radius;
        border-width: 2px;
        border-color: Palette.mint;
    }
}
