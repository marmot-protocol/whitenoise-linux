import { Palette, Theme } from "../tokens.slint";
import { CopyIcon } from "../icons/copy-icon.slint";

// Tap-to-copy pill chip: shows `value` with a copy glyph, flashes "Copied ✓"
// for 1.4s after a tap. Owns the flash state; the tap fires `copy-requested`
// and the caller does the actual clipboard write.
export component CopyChip inherits Rectangle {
    in property <string> value;
    in property <color> value-color: Palette.text-mid;
    // Screen-reader name; falls back to the visible value text when the
    // caller does not pass one, mirroring ActionButton's accessible-label.
    in property <string> label: "";
    callback copy-requested();

    property <bool> copied: false;
    copy-reset := Timer {
        interval: 1.4s;
        running: root.copied;
        triggered => {
            root.copied = false;
        }
    }

    // The single activation the pointer, the keyboard, and assistive tech all run.
    function activate() {
        root.copy-requested();
        root.copied = true;
    }

    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.value;
    accessible-action-default => {
        root.activate();
    }

    height: 30px;
    width: chip-row.preferred-width + 28px;
    border-radius: (15px) * Theme.r-scale;
    background: chip-touch.has-hover ? Palette.field-hover : Palette.field;
    border-width: Theme.border-w;
    border-color: root.copied ? Palette.mint : Palette.field-border;
    animate background, border-color { duration: Theme.transition-dur; }
    chip-row := HorizontalLayout {
        x: 14px;
        width: self.preferred-width;
        spacing: 7px;
        alignment: center;
        Text {
            text: root.copied ? @tr("Copied ✓") : root.value;
            color: root.copied ? Palette.mint : root.value-color;
            font-size: Theme.fs(10.5px, 14px);
            font-weight: 700;
            font-family: Theme.font;
            vertical-alignment: center;
        }

        if !root.copied: VerticalLayout {
            alignment: center;
            CopyIcon {
                stroke: Palette.text-lo;
            }
        }
    }

    chip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activate();
        }
    }

    // Zero-size FocusScope: participates in the Tab chain but never receives
    // pointer events, so clicking the chip can't pull keyboard focus away.
    // Mirrors ActionButton's and the Button primitive's focus handling.
    chip-fs := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activate();
                return accept;
            }
            return reject;
        }
    }

    // Focus ring just outside the bounds (keyboard only).
    if chip-fs.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        background: transparent;
        border-radius: (root.border-radius + 3px);
        border-width: 2px;
        border-color: Palette.mint;
    }
}
