import { ListView } from "std-widgets.slint";
import { EditVersion } from "../tokens.slint";
import { Modal } from "modal.slint";
import { EditHistoryRow } from "edit-history-row.slint";

// Read-only timeline of a message's edit history (original + each edit,
// oldest → newest). Each edit after the original shows an inline word diff
// against the previous version instead of repeating the full text.
export component EditHistoryModal inherits Modal {
    in property <[EditVersion]> versions;
    in property <int> edit-count;

    card-width: 480px;
    card-height: 480px;
    title: @tr("Edit history");
    subtitle: root.edit-count == 1 ? @tr("1 edit") : @tr("%1 edits", root.edit-count);

    ListView {
        vertical-stretch: 1;
        for v[i] in root.versions: EditHistoryRow {
            version: v;
            is-first: i == 0;
            is-last: i == root.versions.length - 1;
        }
    }
}
