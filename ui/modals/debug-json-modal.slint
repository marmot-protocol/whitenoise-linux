import { JsonLine } from "../tokens.slint";
import { Modal } from "modal.slint";
import { JsonView } from "../primitives/json-view.slint";

// Reusable read-only JSON viewer modal for developer/debug dumps (a message's
// raw event, a contact's key packages, an inspected KP, …). The opener fills
// `title`/`subtitle` and Rust pushes tokenized rows into `rows` (see
// src/jsonview.rs); `busy` shows a placeholder while the (blocking) collector
// runs on a worker. "Copy JSON" fires `copy-clicked`; "Close" dismisses
// (Modal's secondary always does).
export component DebugJsonModal inherits Modal {
    in property <[JsonLine]> rows;
    in property <bool> busy: false;
    callback copy-clicked;
    // Forwarded from the viewer's fold chevrons (logical line index).
    callback toggle(int);

    // Sized so a full 60-column tokenizer line (src/jsonview.rs WRAP_COLS)
    // plus the line-number gutter fits without clipping.
    card-width: 560px;
    card-height: 560px;
    primary-label: @tr("Copy JSON");
    secondary-label: @tr("Close");
    primary => {
        root.copy-clicked();
    }

    JsonView {
        vertical-stretch: 1;
        rows: root.rows;
        placeholder: root.busy ? @tr("Loading…") : @tr("(nothing to show)");
        toggle(logical) => {
            root.toggle(logical);
        }
    }
}
