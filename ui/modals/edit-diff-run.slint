import { Palette, Theme } from "../tokens.slint";

// One styled run inside an edit-history diff line.
export component EditDiffRunCell inherits Rectangle {
    in property <string> text;
    // 0 = unchanged, 1 = removed, 2 = added
    in property <int> kind: 0;

    property <bool> removed: root.kind == 1;
    property <bool> added: root.kind == 2;
    property <color> fg: root.added ? Palette.mint : (root.removed ? Palette.text-lo : Palette.text-hi);

    min-width: text-layout.preferred-width + (root.added ? 4px : 0px);
    height: text-layout.preferred-height + (root.added ? 2px : 0px);

    if root.added: Rectangle {
        width: parent.width;
        height: parent.height;
        background: Palette.mint-surface;
        border-radius: 3px * Theme.r-scale;
    }

    text-layout := Text {
        x: root.added ? 2px : 0px;
        y: root.added ? 1px : 0px;
        text: root.text;
        color: root.fg;
        font-size: Theme.fs(13px, 16px);
        font-family: Theme.font;
    }

    if root.removed: Rectangle {
        y: parent.height / 2;
        width: 100%;
        height: 1px;
        background: root.fg;
    }
}
