import { AppState } from "../shell/app-state.slint";
import { Modal, ModalField } from "modal.slint";
import { FormMessages } from "../login/form-messages.slint";

// Danger-zone affordance: change the vault password. Verifies the current
// password (same Argon2id path as unlock), then re-seals the secret map
// under a fresh salt and key. Existing backups stay sealed with the
// previous password.
export component ChangePasswordModal inherits Modal {
    callback confirm(string, string, string); // current, new, confirm

    in-out property <string> current-password;
    in-out property <string> new-password;
    in-out property <string> confirm-password;

    pure function mismatch() -> bool {
        root.confirm-password != "" && root.confirm-password != root.new-password
    }

    card-width: 460px;
    title: @tr("Change vault password");
    subtitle: @tr("Enter your current password, then choose a new one. There is no recovery if you forget it. Existing backups stay sealed with the previous password.");
    secondary-label: @tr("Cancel");
    primary-label: @tr("Change password");
    primary-busy-label: @tr("Changing…");
    primary-danger: true;
    primary-enabled: root.current-password != "" && AppState.login-password-valid(root.new-password, root.confirm-password);
    primary => {
        root.confirm(root.current-password, root.new-password, root.confirm-password);
    }

    VerticalLayout {
        spacing: 12px;
        ModalField {
            label: @tr("CURRENT PASSWORD");
            placeholder: @tr("Your password");
            text <=> root.current-password;
            password: true;
            autofocus: true;
        }

        ModalField {
            label: @tr("NEW PASSWORD");
            placeholder: @tr("Choose a password");
            text <=> root.new-password;
            password: true;
        }

        ModalField {
            label: @tr("CONFIRM NEW PASSWORD");
            placeholder: @tr("Re-enter password");
            text <=> root.confirm-password;
            password: true;
            error: root.mismatch();
            submitted => {
                if (root.primary-enabled && !root.primary-busy) {
                    root.confirm(root.current-password, root.new-password, root.confirm-password);
                }
            }
        }

        FormMessages {
            show-mismatch: root.mismatch();
        }
    }
}
