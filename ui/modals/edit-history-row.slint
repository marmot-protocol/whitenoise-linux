import { Palette, Theme, EditVersion } from "../tokens.slint";
import { EditDiffBody } from "edit-diff-body.slint";

// One node on the edit-history timeline: label + stamp header and either the
// full baseline text (original) or an inline diff vs the previous version.
export component EditHistoryRow inherits Rectangle {
    in property <EditVersion> version;
    in property <bool> is-first: false;
    in property <bool> is-last: false;

    property <length> rail-w: 20px;
    property <length> dot-size: 8px;
    property <length> pad-x: 4px;
    property <length> pad-y: 6px;
    property <string> label: root.version.is-original ? @tr("Original")
        : (root.version.is-current ? @tr("Current") : @tr("Edit %1", root.version.edit-number));

    background: transparent;
    border-width: Theme.border-w;
    border-color: root.version.is-current ? Palette.mint.transparentize(0.55) : transparent;
    border-radius: (8px) * Theme.r-scale;

    item-layout := HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: 12px;

        // Timeline rail — dot plus connector segments above/below.
        VerticalLayout {
            width: root.rail-w;
            alignment: center;
            spacing: 0;

            if !root.is-first: Rectangle {
                width: 2px;
                height: 8px;
                background: Palette.border-2;
            }

            Rectangle {
                width: root.dot-size;
                height: root.dot-size;
                border-radius: root.dot-size / 2;
                background: root.version.is-current ? Palette.mint : Palette.border-2;
                border-width: root.version.is-current ? 0px : Theme.border-w;
                border-color: Palette.text-vlo;
            }

            if !root.is-last: Rectangle {
                width: 2px;
                vertical-stretch: 1;
                min-height: 8px;
                background: Palette.border-2;
            }
        }

        content := VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;

            HorizontalLayout {
                alignment: stretch;
                spacing: 8px;

                Text {
                    text: root.label;
                    color: root.version.is-current ? Palette.mint : Palette.text-mid;
                    font-size: Theme.fs(11px, 14px);
                    font-family: Theme.font;
                    font-weight: 700;
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.version.stamp;
                    color: Palette.text-lo;
                    font-size: Theme.fs(10px, 14px);
                    font-family: Theme.font;
                    vertical-alignment: center;
                }
            }

            if root.version.show-full: Text {
                text: root.version.full-text;
                color: Palette.text-hi;
                font-size: Theme.fs(13px, 16px);
                font-family: Theme.font;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }

            if !root.version.show-full: EditDiffBody {
                horizontal-stretch: 1;
                lines: root.version.diff-lines;
            }
        }
    }

    height: item-layout.preferred-height + root.pad-y * 2;
}
