import { Palette, Theme, ImageSearchHit } from "../tokens.slint";
import { AppState } from "../shell/app-state.slint";
import { SearchIcon } from "../icons/search-icon.slint";
import { CameraIcon } from "../icons/camera-icon.slint";
import { LineInput } from "../primitives/line-input.slint";
import { Button } from "../primitives/button.slint";
import { Modal } from "modal.slint";
import { ScrollView } from "../primitives/scroll-view.slint";

// Remote image search for the group-photo and profile-picture pickers' "search
// the web" badges (GroupHero, ProfilePage). Rust's `image_search` module
// queries Openverse (a keyless, CC-licensed image API — no account, no key)
// and fills `remote-image-search-results`; picking a thumbnail re-enters the
// same Blossom-upload path the local-file pickers use, routed by
// `remote-image-search-target` (1 = group photo, 2 = profile picture).
export component RemoteImageSearchModal inherits Modal {
    property <[ImageSearchHit]> results: AppState.remote-image-search-results;
    property <bool> busy: AppState.remote-image-search-busy;
    property <int> cols: 4;
    property <length> cell: 100px;
    property <length> gap: 8px;

    title: @tr("Search the web for an image");
    card-width: 480px;
    status: AppState.remote-image-search-status;
    grab-focus: false;
    dismissed => {
        AppState.remote-image-search-cancel();
    }

    function run-search() {
        if (AppState.remote-image-search-query != "" && !root.busy) {
            AppState.remote-image-search-run();
        }
    }

    // ── Keyboard grid navigation ──────────────────────────────────────────
    // The query field captures arrow keys (mirrors the emoji picker's
    // search-drives-grid pattern) since a per-tile FocusScope can't move
    // real focus to an arbitrary sibling by index — Slint has no way to
    // address a repeated element instance from outside its own iteration.
    property <int> selected-index: 0;
    function clamp-index(k: int) -> int {
        return max(0, min(k, root.results.length - 1));
    }
    function move-vertical(delta: int) {
        if (root.results.length > 0) {
            root.selected-index = root.clamp-index(root.selected-index + delta * root.cols);
            root.ensure-selected-visible();
        }
    }
    function move-horizontal(delta: int) {
        if (root.results.length > 0) {
            root.selected-index = root.clamp-index(root.selected-index + delta);
            root.ensure-selected-visible();
        }
    }
    function activate-selected() {
        if (root.selected-index >= 0 && root.selected-index < root.results.length) {
            AppState.remote-image-search-pick(root.selected-index);
        }
    }
    function ensure-selected-visible() {
        if (root.gap + floor(root.selected-index / root.cols) * (root.cell + root.gap) < -grid-scroll.viewport-y) {
            grid-scroll.viewport-y = -(root.gap + floor(root.selected-index / root.cols) * (root.cell + root.gap));
        } else if (root.gap + floor(root.selected-index / root.cols) * (root.cell + root.gap) + root.cell > -grid-scroll.viewport-y + grid-scroll.visible-height) {
            grid-scroll.viewport-y = grid-scroll.visible-height - (root.gap + floor(root.selected-index / root.cols) * (root.cell + root.gap) + root.cell);
        }
    }
    changed results => {
        root.selected-index = root.clamp-index(root.selected-index);
    }

    focus-scope := FocusScope {
        init => {
            query-input.take-focus();
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;

                query-input := LineInput {
                    placeholder: @tr("Search term, e.g. \"mountain sunset\"");
                    text <=> AppState.remote-image-search-query;
                    submit => {
                        root.run-search();
                    }
                    font-size: Theme.fsr(14px, 16px);
                    fg: Palette.text-hi;
                    placeholder-color: Palette.text-vlo;
                    capture-nav: true;
                    capture-horizontal: true;
                    nav-tab-commits: false;
                    nav(delta) => {
                        root.move-vertical(delta);
                    }
                    nav-horizontal(delta) => {
                        root.move-horizontal(delta);
                    }
                    commit-mention => {
                        root.activate-selected();
                    }
                    dismiss-mention => {
                        root.dismissed();
                    }
                }

                Button {
                    label: root.busy ? @tr("Searching…") : @tr("Search");
                    min-w: 100px;
                    enabled: !root.busy && AppState.remote-image-search-query != "";
                    clicked => {
                        root.run-search();
                    }
                    SearchIcon {
                        stroke: Palette.text-mid;
                    }
                }
            }

            Rectangle {
                height: 340px;
                clip: true;

                if root.results.length == 0: Text {
                    text: root.busy ? @tr("Searching…") : @tr("Search for an image to use.");
                    color: Palette.text-lo;
                    font-size: Theme.fs(11px, 14px);
                    font-family: Theme.font;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                grid-scroll := ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.visible-width;
                    viewport-height: grid.height;

                    grid := Rectangle {
                        width: parent.width;
                        height: (root.cell + root.gap) * ((root.results.length + root.cols - 1) / root.cols) + root.gap;

                        for hit[i] in root.results: hit-ta := TouchArea {
                            property <int> grid-col: mod(i, root.cols);
                            property <int> grid-row: (i - self.grid-col) / root.cols;
                            x: root.gap + self.grid-col * (root.cell + root.gap);
                            y: root.gap + self.grid-row * (root.cell + root.gap);
                            width: root.cell;
                            height: root.cell;
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: hit.title == "" ? @tr("Use this image") : hit.title;
                            accessible-action-default => {
                                AppState.remote-image-search-pick(i);
                            }
                            clicked => {
                                AppState.remote-image-search-pick(i);
                            }

                            property <bool> kbd-selected: i == root.selected-index && query-input.has-focus;

                            Rectangle {
                                border-radius: (8px) * Theme.r-scale;
                                background: Palette.panel-2;
                                border-width: hit-ta.kbd-selected ? 2px : Theme.border-w;
                                border-color: (hit-ta.has-hover || hit-ta.kbd-selected) ? Palette.mint-dim : Palette.elevated-border;
                                clip: true;

                                if hit.has-thumbnail: Image {
                                    source: hit.thumbnail;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }

                                if !hit.has-thumbnail: CameraIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    stroke: Palette.text-vlo;
                                }
                            }

                            // Focus ring just outside the bounds (keyboard
                            // only) — mirrors ActionButton/QuickReactCell.
                            if hit-ta.kbd-selected: Rectangle {
                                x: -3px;
                                y: -3px;
                                width: parent.width + 6px;
                                height: parent.height + 6px;
                                background: transparent;
                                border-radius: (11px) * Theme.r-scale;
                                border-width: 2px;
                                border-color: Palette.mint;
                            }
                        }
                    }
                }
            }
        }
    }
}
