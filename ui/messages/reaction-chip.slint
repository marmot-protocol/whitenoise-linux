import {
    Palette,
    Theme,
    Reactor,
    ProfileSink,
    EmojiSheet,
} from "../tokens.slint";
import { ChevronDownIcon } from "../icons/chevron-down-icon.slint";

// A single emoji + count chip. `mine` controls the highlight style.
export component ReactionChip inherits Rectangle {
    in property <string> emoji;
    // Sprite-sheet tile for `emoji`; clip-x < 0 falls back to the text glyph.
    in property <int> clip-x: -1;
    in property <int> clip-y: -1;
    in property <int> count;
    in property <bool> mine: false;
    // Everyone who used this emoji, shown as mention chips in the hover popover
    // below. Empty while a just-added reaction is still optimistic.
    in property <[Reactor]> reactors;
    callback clicked();
    // Popover open-state: the caret below is the one way in for mouse, touch,
    // and keyboard alike (no hover-open path, so no hover-intent machinery),
    // and it stays open until toggled again or Escape.
    property <bool> manual-open: false;
    // Which reactor the caret's arrow keys have selected while the popover is
    // open via keyboard; mirrors AccentPicker's focus-idx.
    property <int> cursor-idx: 0;

    height: 22px;
    min-width: 36px;
    border-radius: (11px) * Theme.r-scale;
    border-width: 1px;
    border-color: root.mine ? Palette.mint : (touch.has-hover ? Palette.mint-dim : Palette.border-2);
    background: root.mine ? Palette.mint-surface : (touch.has-hover ? Palette.panel-2 : Palette.panel);
    horizontal-stretch: 0;
    // Pop-in: when a new chip appears (optimistic add, or relay echo), it
    // fades in. Colors animate too so toggling `mine` glides between states.
    property <float> enter: 0;
    init => {
        self.enter = 1;
    }
    animate enter {
        duration: 160ms;
        easing: ease-out;
    }
    opacity: root.enter;
    animate background, border-color {
        duration: 140ms;
        easing: ease-out;
    }

    // Declared before the HorizontalLayout (and its caret button below) so it
    // paints underneath: the caret's own TouchArea, nested later, wins the hit
    // test for its small region while this one still covers the rest of the
    // pill. See ui/messages/reaction-chip.slint's caret for the click it must
    // not swallow.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;
        // Colour tile from the shared Twemoji sheet (matching the quick-reaction
        // row and inline body emoji); text glyph when the sheet lacks it.
        if root.clip-x >= 0: Image {
            width: 15px;
            height: 15px;
            source: EmojiSheet.sprite;
            source-clip-x: root.clip-x;
            source-clip-y: root.clip-y;
            source-clip-width: EmojiSheet.tile;
            source-clip-height: EmojiSheet.tile;
        }
        if root.clip-x < 0: Text {
            text: root.emoji;
            font-size: Theme.fs(12px, 16px);
            vertical-alignment: center;
        }

        if root.count > 1: Text {
            text: root.count;
            color: root.mine ? Palette.text-hi : Palette.text-mid;
            font-size: Theme.fs(11px, 14px);
            font-weight: 600;
            vertical-alignment: center;
        }

        // Explicit, non-hover affordance to open the reactor list: the popover
        // above otherwise only mounts on pointer hover, so touch and keyboard
        // users had no way to reach it. Its own click toggles `manual-open`
        // rather than `root.clicked()`, keeping "view reactors" and "toggle my
        // reaction" on separate gestures.
        if root.reactors.length > 0: caret := Rectangle {
            width: 16px;
            height: 16px;
            border-radius: (8px) * Theme.r-scale;
            background: caret-touch.has-hover || root.manual-open ? Palette.hover : transparent;
            animate background { duration: Theme.hover-dur; }
            accessible-role: button;
            accessible-label: root.manual-open ? @tr("Hide who reacted") : @tr("See who reacted");
            accessible-action-default => { caret.activate(); }
            function activate() {
                root.manual-open = !root.manual-open;
                root.cursor-idx = 0;
            }

            ChevronDownIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 8px;
                stroke: root.mine ? Palette.text-hi : Palette.text-mid;
                flip: root.manual-open;
            }

            caret-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    caret.activate();
                }
            }

            // Zero-size FocusScope: joins the Tab chain without taking pointer
            // events. Mirrors add-member-row.slint and chat-search-bar.slint.
            // Once open, Up/Down cycle `cursor-idx` over the reactor list and
            // Enter/Space open the selected reactor's profile (mirroring
            // AccentPicker's arrow-key model); Escape closes the popover.
            caret-fs := FocusScope {
                width: 0px;
                height: 0px;
                key-pressed(event) => {
                    if (event.text == Key.Escape && root.manual-open) {
                        root.manual-open = false;
                        return accept;
                    }
                    if (root.manual-open && event.text == Key.UpArrow) {
                        root.cursor-idx = root.cursor-idx == 0 ? root.reactors.length - 1 : root.cursor-idx - 1;
                        return accept;
                    }
                    if (root.manual-open && event.text == Key.DownArrow) {
                        root.cursor-idx = mod(root.cursor-idx + 1, root.reactors.length);
                        return accept;
                    }
                    if (event.text == Key.Return || event.text == " ") {
                        if (root.manual-open) {
                            ProfileSink.open(root.reactors[root.cursor-idx].id);
                        } else {
                            caret.activate();
                        }
                        return accept;
                    }
                    return reject;
                }
            }
            if caret-fs.has-focus: Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: (11px) * Theme.r-scale;
                border-width: 2px;
                border-color: Palette.mint;
                background: transparent;
            }
        }
    }

    // The caret opens the list of who reacted with this emoji. Each reactor
    // is a mention chip (same plate + gradient as an @mention); clicking one
    // opens their profile through the same `ProfileSink` avatars and mentions
    // use. The card sits just above the chip.
    if root.manual-open && root.reactors.length > 0: Rectangle {
        x: 0;
        y: -self.height;
        width: pop-col.preferred-width + 16px;
        height: pop-col.preferred-height + 12px;
        background: transparent;

        // The visible card, with a 4px breather above the chip.
        card := Rectangle {
            width: 100%;
            height: parent.height - 4px;
            background: Palette.elevated;
            border-radius: (8px) * Theme.r-scale;
            border-width: Theme.border-w;
            border-color: Palette.elevated-border;
            drop-shadow-color: Theme.hard-shadow ? Palette.shadow : Palette.shadow-float;
            drop-shadow-offset-y: Theme.hard-shadow ? 2px : 1px;
            drop-shadow-blur: Theme.hard-shadow ? 0px : 6px;
        }

        pop-col := VerticalLayout {
            x: 8px;
            y: 6px;
            spacing: 4px;
            for reactor[idx] in root.reactors: HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: 22px;
                    border-radius: min((6px) * Theme.r-scale, self.height / 2);
                    background: @linear-gradient(135deg, reactor.a 0%, reactor.b 100%);
                    // Subtle outline on hover, or on the keyboard cursor
                    // (root.cursor-idx), so the badge reads as clickable and
                    // as keyboard-activatable.
                    border-width: rt.has-hover || (root.manual-open && root.cursor-idx == idx) ? 1px : 0px;
                    border-color: Palette.avatar-ring;
                    accessible-role: button;
                    accessible-label: @tr("Open {}'s profile", reactor.name);
                    accessible-action-default => {
                        ProfileSink.open(reactor.id);
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: reactor.name;
                            color: white;
                            font-size: Theme.fs(11px, 14px);
                            font-weight: 600;
                            font-family: Theme.font;
                            vertical-alignment: center;
                        }
                    }

                    // Clicking a reactor opens their profile — the same modal
                    // `ProfileSink` opens from an @mention or an avatar.
                    rt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            ProfileSink.open(reactor.id);
                        }
                    }
                }
            }
        }
    }
}
