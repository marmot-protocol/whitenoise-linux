import {
    Palette,
    Theme,
    ChatMessage,
    ProfileSink,
} from "../tokens.slint";
import { AppState } from "../shell/app-state.slint";
import { Avatar } from "../primitives/avatar.slint";
import { MessageBody } from "message-body.slint";
import { ReactionsRow, MessageRules } from "reactions-row.slint";
import { StampBadge } from "stamp-badge.slint";

// Flat desktop-chat row (Discord/Slack style): every message is left-aligned,
// the first message of a group carries the avatar and a name header, and
// continuation rows indent under it. Incoming and outgoing render identically;
// the sender name is the identity cue. Message actions live in the right-click
// context menu (see message-context-menu.slint) and are invoked by the body
// itself straight on AppState — this component is only the row chrome: hover
// tint, avatar gutter, name header.
export component MessageRow inherits Rectangle {
    // The whole message — fields render via `root.msg.*` (see ChatMessage in
    // tokens.slint for per-field docs). Only row context that is not carried
    // on the message stays a scalar property.
    in property <ChatMessage> msg;
    in property <bool> highlighted: false;
    in property <length> row-w: 9999px;

    // Jump-highlight / mention / hover tint spans the whole row (the flat
    // replacement for the old per-message accents), Discord-style. A covered
    // TouchArea never reports has-hover, so the row sensor alone goes blind
    // over the body/avatar/header — those report back through `body.hovered`
    // and `aux-hover` (synced by changed-handlers in the if-branches below,
    // whose ids are not referable from here).
    property <bool> aux-hover: false;
    property <bool> row-hovered: row-hover.has-hover || body.hovered || root.aux-hover;
    background: root.highlighted ? Palette.mint-glow : (root.msg.mentioned ? Palette.selected : (root.row-hovered ? Palette.hover : transparent));
    animate background { duration: Theme.hover-dur; }

    // Full-row hover sensor, declared first so every interactive element on
    // top of it keeps winning its own clicks. It only feeds the row tint.
    row-hover := TouchArea {}

    // Resolved by MessageView (shared with the terminal skin).
    in property <string> author-label;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        // The 18px pane inset lives here (not on the ListView delegate) so
        // the row's tint bleeds edge-to-edge; the vertical padding gives each
        // row breathing room inside its own tint.
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 3px;
        padding-bottom: 3px;

        // Avatar gutter: the first message of a group shows the avatar
        // (outgoing rows read the user's own `my-av-*` picture so it matches
        // the left rail); continuations keep an empty gutter for alignment.
        if root.msg.show-avatar: TouchArea {
            width: 28px;
            height: 28px;
            mouse-cursor: pointer;
            changed has-hover => {
                root.aux-hover = self.has-hover;
            }
            clicked => {
                if (root.msg.sender-id != "") {
                    ProfileSink.open(root.msg.sender-id);
                }
            }
            Avatar {
                size: 28px;
                y: 0;
                initials: root.msg.av-initials;
                color-a: root.msg.av-a;
                color-b: root.msg.av-b;
                picture: root.msg.outgoing ? AppState.my-av-picture : root.msg.picture;
                has-picture: root.msg.outgoing ? AppState.my-av-has-picture : root.msg.has-picture;
                a11y-label: root.author-label;
                font-size: Theme.fs(9px, 14px);
            }
        }
        if !root.msg.show-avatar: Rectangle {
            width: 28px;
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            // Name header on the first message of a group — everyone gets one
            // (own messages included), so authorship never depends on sides.
            // The timestamp rides after the name, Discord-style; hovering it
            // reveals the full localized datetime.
            if root.msg.show-sender-name && root.msg.sender-name != "": HorizontalLayout {
                alignment: start;
                spacing: 8px;
                // Fixed height with both labels pinned to the bottom edge:
                // that puts name and timestamp on one shared line (a Text with
                // implicit size would be CENTERED in its wrapper while the
                // stamp bottom-aligns, drifting them apart) and drops the name
                // a couple of px below the avatar's top, Discord-style.
                height: 16px;
                Rectangle {
                    // Clamped so a long profile name elides instead of
                    // widening the row past the pane (and pushing the stamp
                    // out of view).
                    width: min(name-label.preferred-width, max(120px, root.row-w - 160px));
                    name-label := Text {
                        width: 100%;
                        x: 0;
                        height: 100%;
                        vertical-alignment: bottom;
                        text: root.msg.sender-name;
                        color: name-touch.has-hover ? Palette.text-hi : Palette.text-mid;
                        animate color { duration: Theme.hover-dur; }
                        font-size: Theme.fs(11px, 12px);
                        font-weight: 700;
                        font-family: Theme.font;
                        overflow: elide;
                    }
                    name-touch := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            root.aux-hover = self.has-hover;
                        }
                        clicked => {
                            if (root.msg.sender-id != "") {
                                ProfileSink.open(root.msg.sender-id);
                            }
                        }
                    }
                }

                if root.msg.stamp != "": StampBadge {
                    stamp: root.msg.stamp;
                    stamp-full: root.msg.stamp-full;
                    fg: root.msg.failed ? Palette.danger : Palette.text-lo;
                    changed hovered => {
                        root.aux-hover = self.hovered;
                    }
                }
            }

            body := MessageBody {
                msg: root.msg;
                author-label: root.author-label;
                available-w: max(80px, root.row-w - 28px - 10px - 10px);
            }

            // Reaction chips — only present when the message has reactions, so
            // empty messages stack tightly.
            if MessageRules.show-reactions(root.msg): ReactionsRow {
                message-id: root.msg.message-id;
                rows: root.msg.reaction-rows;
            }
        }
    }
}
