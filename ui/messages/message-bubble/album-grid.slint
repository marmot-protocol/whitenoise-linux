import { Palette, Theme, ChatMessage } from "../../tokens.slint";

// Album grid. Each cell's rect is precomputed in Rust; we absolute-position
// a clipped image (or a subtle placeholder until it decodes).
export component AlbumGrid inherits Rectangle {
    in property <ChatMessage> msg;
    callback cell-clicked(string);
    width: root.msg.album-w;
    height: root.msg.album-h;
    for cell[i] in root.msg.album: Rectangle {
        x: cell.x;
        y: cell.y;
        width: cell.w;
        height: cell.h;
        border-radius: (6px) * Theme.r-scale;
        background: root.msg.outgoing ? Palette.bubble-inset-out : Palette.bubble-inset;
        clip: true;
        border-width: Theme.outline-surfaces ? Theme.border-w : 0px;
        border-color: Palette.border-2;

        accessible-role: button;
        accessible-enabled: !cell.loading || cell.failed;
        accessible-label: cell.failed
            ? @tr("Image {} of {}, failed to load. Activate to retry.", i + 1, root.msg.album.length)
            : (cell.loading
                ? @tr("Image {} of {}, loading.", i + 1, root.msg.album.length)
                : @tr("Image {} of {}", i + 1, root.msg.album.length));
        accessible-action-default => {
            if !cell.loading || cell.failed {
                root.cell-clicked(cell.key);
            }
        }
        if cell.has-image: Image {
            width: parent.width;
            height: parent.height;
            source: cell.image;
            image-fit: cover;
        }
        if !cell.has-image: Text {
            // Three distinct states: failed (⚠, danger colour, tap to retry),
            // still-loading (…), and the neutral pre-load placeholder (🖼).
            text: cell.failed ? "⚠" : (cell.loading ? "…" : "🖼");
            color: cell.failed
                ? Palette.danger-on-bubble
                : (root.msg.outgoing ? Palette.bubble-out-fg : Palette.text-mid);
            font-size: Theme.fs(22px, 26px);
            font-family: Theme.font;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: cell.failed ? 1.0 : 0.7;
        }
        TouchArea {
            // Loading cells stay inert, but a failed cell must accept the tap
            // that retries its download.
            enabled: !cell.loading || cell.failed;
            mouse-cursor: pointer;
            clicked => {
                root.cell-clicked(cell.key);
            }
        }

        // Zero-size FocusScope: joins the Tab chain without stealing pointer
        // events, mirroring QuickReactCell's focus handling.
        fs := FocusScope {
            width: 0px;
            height: 0px;
            enabled: !cell.loading || cell.failed;
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == " ") {
                    root.cell-clicked(cell.key);
                    return accept;
                }
                return reject;
            }
        }

        // Focus ring just inside the cell bounds (keyboard only) — the cell
        // clips, so an outer ring like QuickReactCell's would be cut off.
        if fs.has-focus: Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: transparent;
            border-radius: (4px) * Theme.r-scale;
            border-width: 2px;
            border-color: Palette.mint;
        }
    }
}
