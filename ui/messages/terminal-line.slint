import { Palette, Theme, ChatMessage } from "../tokens.slint";
import { AppState } from "../shell/app-state.slint";
import { ReactionsRow, MessageRules } from "reactions-row.slint";
import { StampBadge } from "stamp-badge.slint";

// Terminal skin (Theme.skin-message == 1): `<sender> message text` lines, no
// avatars or bodies. Reaction chips ride under the line when present.
export component TerminalLine inherits VerticalLayout {
    in property <ChatMessage> msg;
    in property <bool> highlighted: false;
    // Resolved by MessageView (shared with the flat-row skin).
    in property <string> author-label;
    spacing: 0;

    line := Rectangle {
        // Attachment state. Albums carry their cells in `album`; single
        // attachments use the `att-*` fields. A line with media routes its tap to
        // the same viewer/slideshow the body uses (attachment-clicked /
        // album-cell-clicked) so images stay openable in terminal mode.
        property <bool> is-album: root.msg.album.length > 0;
        property <bool> has-media: self.is-album || root.msg.has-attachment;
        property <string> media-label:
            self.is-album ? @tr("[{} images — click to view]", root.msg.album.length)
            : (root.msg.att-is-image ? @tr("[image: {} — click to view]", root.msg.att-name)
            : (root.msg.att-is-video ? @tr("[video: {} — click to play]", root.msg.att-name)
            : (root.msg.att-is-audio ? @tr("[audio: {}]", root.msg.att-name)
            : @tr("[file: {}]", root.msg.att-name))));
        // Shared whole-line action: album → attachment → reply.
        function activate() {
            if (self.is-album) {
                AppState.album-cell-clicked(root.msg.album[0].key);
            } else if (root.msg.has-attachment) {
                AppState.attachment-clicked(root.msg.message-id);
            } else {
                AppState.request-reply(root.msg.message-id, root.msg.text, root.author-label);
            }
        }

        background: root.highlighted ? Palette.mint-glow : (root.msg.mentioned ? Palette.selected : (term-touch.has-hover ? Palette.hover : transparent));
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 1px;
            padding-bottom: 1px;
            spacing: 6px;
            alignment: start;
            Text {
                text: "<" + root.author-label + ">";
                color: root.msg.outgoing ? Palette.mint-dim : Palette.mint;
                font-family: Theme.font;
                font-size: Theme.fs(13px, 16px);
                font-weight: 700;
                vertical-alignment: top;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 1px;
                if root.msg.deleted: Text {
                    text: @tr("This message was deleted");
                    color: Palette.text-mid;
                    font-family: Theme.font;
                    font-size: Theme.fs(13px, 16px);
                    font-italic: true;
                    wrap: word-wrap;
                }
                if root.msg.text != "" && !root.msg.deleted: Text {
                    text: root.msg.text;
                    color: root.msg.failed ? Palette.danger : Palette.text-hi;
                    font-family: Theme.font;
                    font-size: Theme.fs(13px, 16px);
                    wrap: word-wrap;
                }
                // Accent-colored, clickable attachment label (the whole line is
                // the click target — see term-touch below).
                if line.has-media && !root.msg.deleted: Text {
                    text: line.media-label;
                    color: Palette.mint;
                    font-family: Theme.font;
                    font-size: Theme.fs(12px, 16px);
                    font-weight: 700;
                    wrap: word-wrap;
                }
            }

            // The stamp forwards clicks to the same handler as `term-touch`
            // (which it sits on top of) so the whole-line click target keeps
            // working over it.
            if root.msg.stamp != "": StampBadge {
                stamp: root.msg.stamp;
                stamp-full: root.msg.stamp-full;
                fg: Palette.text-vlo;
                fs: Theme.fs(11px, 14px);
                bottom-align: false;
                tip-right: true;
                clickable: true;
                clicked => {
                    line.activate();
                }
            }
        }
        // One TouchArea for the whole line; the action is chosen in the handler
        // (album → attachment → reply) to avoid overlapping/if-mounted TouchAreas.
        // A retracted tombstone offers no actions, so the right-click branch is
        // suppressed the same way the body skin's context menu is.
        term-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                line.activate();
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right
                        && root.msg.message-id != "" && !root.msg.deleted) {
                    AppState.arm-context-menu(
                        root.msg.message-id, root.msg.text,
                        root.author-label, root.msg.can-edit,
                        self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }

    // Reaction chips — same gate as MessageRow (shared `MessageRules`).
    if MessageRules.show-reactions(root.msg): HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 2px;
        ReactionsRow {
            message-id: root.msg.message-id;
            rows: root.msg.reaction-rows;
        }
    }
}
