// Message-row skin slot (theming engine, Layer 1).
//
// Takes one ChatMessage (the view-model contract struct) plus the small bit of
// row context that isn't on the message itself, and dispatches to the render
// body selected by `Theme.skin-message`. Skin 0 is the standard flat message
// rows; skin 1 the terminal line. A drastic theme adds skin 2+ here and
// selects it via its ThemeStyle pack — without any change to messages.slint or
// the Rust glue. See ui/CONTRACT.md.
//
// Actions (react/reply/edit/context/attachment/…) are invoked straight on the
// AppState contract by whichever element originates them, and effect bursts
// go through the MessageFx sink — no callback forwarding through this slot.
import { Theme, ChatMessage } from "../tokens.slint";
import { MessageRow } from "message-row.slint";
import { TerminalLine } from "terminal-line.slint";
import { SystemLine } from "system-line.slint";

export component MessageView inherits VerticalLayout {
    spacing: 0;

    // The whole message (skins read whatever fields they render).
    in property <ChatMessage> msg;
    in property <bool> highlighted: false;
    // Row context not carried on the message.
    in property <length> row-w: 9999px;
    // The one author-label resolution, shared by every skin.
    property <string> author-label: root.msg.outgoing
        ? @tr("You")
        : (root.msg.sender-name != "" ? root.msg.sender-name : root.msg.av-initials);


    // ── Group system row: a centered system line, shared across every skin.
    // Rendered before the skins and guarded out of them below so a kind-1210
    // record never falls into a message body or terminal line. ──
    if root.msg.system-line: SystemLine {
        msg: root.msg;
    }

    // ── Skin 0: standard flat rows (incoming and outgoing render the same) ──
    if Theme.skin-message == 0 && !root.msg.system-line: MessageRow {
        msg: root.msg;
        highlighted: root.highlighted;
        row-w: root.row-w;
        author-label: root.author-label;
    }

    // ── Skin 1: terminal line — `<sender> message text` ──
    if Theme.skin-message == 1 && !root.msg.system-line: TerminalLine {
        msg: root.msg;
        highlighted: root.highlighted;
        author-label: root.author-label;
    }
}
