import { AppState } from "../shell/app-state.slint";
import { ChatMessage, ReactionRow } from "../tokens.slint";
import { ReactionChip } from "reaction-chip.slint";

// View rules shared by the message skins.
export global MessageRules {
    // The one gate both skins use to decide whether a message renders its
    // reaction chips: confirmed rows only (never pending, failed, or
    // synthetic), and only when chips exist, so empty messages stack tightly.
    public pure function show-reactions(msg: ChatMessage) -> bool {
        return msg.message-id != "" && !msg.pending && !msg.failed && msg.reaction-rows.length > 0;
    }
}

// In-flow block of reaction chips, rendered directly under a message body (only
// when the message actually has reactions, so empty messages stay tight).
// `rows` is already wrapped Rust-side to the body's width cap, so this
// just stacks each row and lets a chip overflow onto the next one. Tapping a
// chip toggles my reaction on/off.
export component ReactionsRow inherits VerticalLayout {
    in property <string> message-id;
    in property <[ReactionRow]> rows;

    spacing: 6px;

    for row in root.rows: HorizontalLayout {
        spacing: 6px;
        alignment: start;

        for r in row.chips: ReactionChip {
            emoji: r.emoji;
            clip-x: r.clip-x;
            clip-y: r.clip-y;
            count: r.count;
            mine: r.mine;
            reactors: r.reactors;
            clicked => {
                if (r.mine) {
                    AppState.unreact-message(root.message-id, r.emoji);
                } else {
                    AppState.react-message(root.message-id, r.emoji);
                }
            }
        }
    }
}
