import { Palette, Theme, EmojiSheet } from "../tokens.slint";
import { KeyActivate } from "../primitives/key-activate.slint";

// One tappable emoji in the quick-reaction row (the context
// menu, and the Settings editor). Renders the glyph over a hover highlight.
// `removable` overlays a small ✕ on hover or focus so the same cell doubles
// as the delete control in the Settings editor, where a tap removes the
// emoji.
export component QuickReactCell inherits Rectangle {
    in property <string> emoji;
    // Sprite-sheet tile for `emoji`; clip-x < 0 falls back to the text glyph.
    in property <int> clip-x: -1;
    in property <int> clip-y: -1;
    // A custom-uploaded emoji's own image (Settings → General → Custom
    // Emoji row); takes priority over both the sprite tile and the text
    // fallback below.
    in property <image> picture;
    in property <bool> has-picture: false;
    in property <bool> removable: false;
    // Screen-reader name; the Settings editor's remove cells override this to
    // say what a tap does instead of what it shows.
    in property <string> a11y-label: root.emoji == "+" ? @tr("Add reaction") : @tr("React with {}", root.emoji);
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: (8px) * Theme.r-scale;
    background: touch.has-hover ? Palette.hover : transparent;
    animate background { duration: Theme.hover-dur; }

    accessible-role: button;
    accessible-label: root.a11y-label;
    accessible-action-default => {
        root.clicked();
    }

    // A custom-uploaded emoji's own image (Settings editor row only).
    if root.has-picture: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.picture;
        image-fit: contain;
    }

    // A tile from the shared Twemoji sheet — the same texture the message rows
    // draw inline emoji from, so a quick reaction looks identical to the emoji
    // it posts.
    if !root.has-picture && root.clip-x >= 0: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: EmojiSheet.sprite;
        source-clip-x: root.clip-x;
        source-clip-y: root.clip-y;
        source-clip-width: EmojiSheet.tile;
        source-clip-height: EmojiSheet.tile;
    }

    // Fallback glyph: the "+" add cell, or an emoji the sheet doesn't carry.
    if !root.has-picture && root.clip-x < 0: Text {
        width: 100%;
        height: 100%;
        text: root.emoji;
        font-size: Theme.fs(15px, 18px);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Delete affordance for the editor: a red ✕ badge that shows on hover or
    // keyboard focus, so the row reads as emoji until the user reaches for
    // one to remove.
    if root.removable && (touch.has-hover || ka.focused): Rectangle {
        x: parent.width - self.width + 3px;
        y: -3px;
        width: 14px;
        height: 14px;
        border-radius: (7px) * Theme.r-scale;
        background: Palette.danger;
        Text {
            text: "✕";
            color: white;
            font-size: Theme.fs(8px, 12px);
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    ka := KeyActivate {
        ring-radius: (11px) * Theme.r-scale;
        activate => {
            root.clicked();
        }
    }
}
