import { AppState } from "../shell/app-state.slint";
import { Palette, Theme, QuickReact } from "../tokens.slint";
import { QuickReactCell } from "quick-react-cell.slint";
import { ActionButton } from "../primitives/action-button.slint";
import { Tooltip } from "../primitives/tooltip.slint";

// Floating action toolbar — a one-tap quick-reaction row (👍 ❤️ … + "+" into
// the full picker), then reply and (author-only) edit. Positioned by the row to
// the side of the bubble and shown on hover. It's a self-contained card so it
// reads as a hovering control rather than chrome baked into the row. `hovered`
// tracks the whole bar (via the ancestor TouchArea) so the row can keep it open
// while the pointer is on a cell (which steals hover from the bubble sensor).
export component HoverActions inherits Rectangle {
    in property <string> message-id;
    in property <string> reply-preview-text;
    in property <string> reply-author;
    in property <bool> can-edit: false;
    // A single ancestor TouchArea reports the hover for the whole bar (it stays
    // hovered while the pointer is over any nested cell/button, so the row can
    // keep the toolbar open), and nested cell TouchAreas still win their own
    // clicks — the wrapping pattern the emoji picker and context menu rely on.
    out property <bool> hovered: bar-touch.has-hover;
    // Whether any button inside the bar holds keyboard focus. The row that
    // hosts this bar reads it to keep the toolbar revealed while a Tab user
    // is on one of its buttons, since the bar itself only mounts visibly on
    // hover otherwise.
    out property <bool> focus-within: plus-btn.focused || reply-btn.focused || edit-btn.focused;
    // Which side the button tooltips float on. The host sets it to match the
    // bar's own placement (bar below the bubble → tips below the bar), so a
    // tooltip never covers the message it belongs to.
    in property <bool> tips-below: false;
    property <length> tip-y-below: root.height + 8px;

    width: bar.preferred-width;
    height: bar.preferred-height;
    border-radius: (10px) * Theme.r-scale;
    background: Palette.elevated;
    border-width: Theme.border-w;
    border-color: Palette.elevated-border;
    drop-shadow-color: Theme.hard-shadow ? Palette.shadow : Palette.shadow-float;
    drop-shadow-offset-y: Theme.hard-shadow ? 2px : 2px;
    drop-shadow-blur: Theme.hard-shadow ? 0px : 10px;

    bar-touch := TouchArea {
        bar := HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            // One-tap quick reactions, then a "+" that opens the full picker.
            for e in QuickReact.list: QuickReactCell {
                emoji: e.emoji;
                clip-x: e.clip-x;
                clip-y: e.clip-y;
                clicked => {
                    QuickReact.react(root.message-id, e.emoji);
                }
            }

            plus-btn := ActionButton {
                glyph: "+";
                label: @tr("Add reaction");
                clicked => {
                    AppState.emoji-picker-requested(
                        root.message-id,
                        self.absolute-position.x,
                        self.absolute-position.y + self.height,
                    );
                }
            }

            // Divider between the reactions and the message actions.
            Rectangle {
                width: 7px;
                Rectangle {
                    x: 3px;
                    y: 6px;
                    width: 1px;
                    height: parent.height - 12px;
                    background: Palette.border-2;
                }
            }

            reply-btn := ActionButton {
                glyph: "↩";
                label: @tr("Reply");
                clicked => {
                    AppState.request-reply(root.message-id, root.reply-preview-text, root.reply-author);
                }
            }

            edit-btn := ActionButton {
                glyph: "✎";
                label: @tr("Edit message");
                shown: root.can-edit;
                clicked => {
                    AppState.request-edit(root.message-id, root.reply-preview-text);
                }
            }
        }
    }

    // Hover tooltips for the toolbar's icon-only buttons, floated above the
    // bar the same way composer.slint's send-button tooltip is: positioned
    // from the button's absolute position rather than nested inside it, so
    // it paints outside the bar's own bounds.
    if plus-btn.hovered || plus-btn.focused: Tooltip {
        x: plus-btn.absolute-position.x - root.absolute-position.x + plus-btn.width / 2 - self.width / 2;
        y: root.tips-below ? root.tip-y-below : -self.height - 8px;
        label: plus-btn.label;
        is-visible: true;
    }
    if reply-btn.hovered || reply-btn.focused: Tooltip {
        x: reply-btn.absolute-position.x - root.absolute-position.x + reply-btn.width / 2 - self.width / 2;
        y: root.tips-below ? root.tip-y-below : -self.height - 8px;
        label: reply-btn.label;
        is-visible: true;
    }
    if edit-btn.hovered || edit-btn.focused: Tooltip {
        x: edit-btn.absolute-position.x - root.absolute-position.x + edit-btn.width / 2 - self.width / 2;
        y: root.tips-below ? root.tip-y-below : -self.height - 8px;
        label: edit-btn.label;
        is-visible: true;
    }
}
