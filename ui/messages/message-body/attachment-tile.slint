import { ChatMessage } from "../../tokens.slint";
import { VideoTile } from "video-tile.slint";
import { AudioTile } from "audio-tile.slint";
import { ImageTile } from "image-tile.slint";
import { FileChip } from "file-chip.slint";

// Single-attachment slot: routes the message's attachment to its kind's tile
// (video poster, audio player, image preview, generic file chip), so the body
// mounts one element behind one gate instead of four.
export component AttachmentTile inherits VerticalLayout {
    in property <ChatMessage> msg;
    in property <length> text-budget;
    callback clicked();
    callback audio-play-clicked();
    callback audio-seek-clicked(float);

    if root.msg.att-is-video: VideoTile {
        msg: root.msg;
        text-budget: root.text-budget;
        clicked => {
            root.clicked();
        }
    }
    if root.msg.att-is-audio: AudioTile {
        msg: root.msg;
        text-budget: root.text-budget;
        play-clicked => {
            root.audio-play-clicked();
        }
        seek-clicked(frac) => {
            root.audio-seek-clicked(frac);
        }
    }
    if root.msg.att-is-image: ImageTile {
        msg: root.msg;
        text-budget: root.text-budget;
        clicked => {
            root.clicked();
        }
    }
    if !root.msg.att-is-image && !root.msg.att-is-video && !root.msg.att-is-audio: FileChip {
        msg: root.msg;
        text-budget: root.text-budget;
        clicked => {
            root.clicked();
        }
    }
}
