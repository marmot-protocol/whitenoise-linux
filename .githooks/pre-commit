#!/usr/bin/env bash
# Project pre-commit hook. Enforced via core.hooksPath=.githooks
# (run scripts/install-hooks.sh once per clone to activate).
#
#   1. Normalize every staged PO/POT catalog in place, then re-stage it, so the
#      working tree matches what the po-clean filter writes to the index.
#   2. Refresh .github/workflows/pr-precommit.yml (GitHub's byte-identical
#      mirror of the canonical ngit-ci gate at
#      .ngit/act/workflows/pr-precommit.yml) and re-stage it on drift.
#
# Emergency bypass:  git commit --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# NUL-safe list of paths staged for this commit (Added/Copied/Modified/Renamed).
staged() { git diff --cached --name-only --diff-filter=ACMR -z "$@"; }

# --- 1. Normalize staged catalogs ---------------------------------------
po_changed=0
while IFS= read -r -d '' f; do
    [ -f "$f" ] || continue          # skip deletions
    tmp="$(mktemp)"
    if scripts/po-clean.sh < "$f" > "$tmp" && ! cmp -s "$f" "$tmp"; then
        cat "$tmp" > "$f"
        git add -- "$f"
        po_changed=1
    fi
    rm -f "$tmp"
done < <(staged -- '*.po' '*.pot')
[ "$po_changed" = 1 ] && echo "pre-commit: normalized staged PO/POT catalogs."

# Validate staged catalogs with msgfmt. --check makes malformed entries fatal;
# treating any stderr output as a failure also catches the non-fatal header
# warnings (missing/placeholder fields) so they can't creep back in.
if staged -- '*.po' '*.pot' | grep -qz .; then
    if ! command -v msgfmt >/dev/null 2>&1; then
        echo "✗ msgfmt not found — needed to validate staged PO/POT catalogs." >&2
        echo "  Install gettext (e.g. apt install gettext / pacman -S gettext)" >&2
        exit 1
    fi
    while IFS= read -r -d '' f; do
        [ -f "$f" ] || continue          # skip deletions
        if ! err="$(msgfmt --check -o /dev/null "$f" 2>&1)" || [ -n "$err" ]; then
            printf '✗ msgfmt --check failed on %s:\n%s\n' "$f" "$err" >&2
            exit 1
        fi
    done < <(staged -- '*.po' '*.pot')
    echo "pre-commit: msgfmt --check passed on staged catalogs."
fi

# --- 2. Sync the GitHub mirror of the ngit-ci gate ----------------------
# .ngit/act/workflows/pr-precommit.yml is canonical (ngit is the primary
# forge); GitHub cannot run workflows through symlinks, so a byte-identical
# copy must exist at .github/workflows/pr-precommit.yml. Refresh the mirror
# from the canonical file and re-stage it whenever the two differ — including
# when someone edited the mirror directly (the canonical side always wins).
# Under CI (pr-precommit.yml runs this hook with everything staged), a
# refresh here re-stages the mirror and the workflow's final drift check
# turns that into a failure — so a proposal can't land with drifted copies.
gate_src=".ngit/act/workflows/pr-precommit.yml"
gate_dst=".github/workflows/pr-precommit.yml"
if [ -f "$gate_src" ] && ! cmp -s "$gate_src" "$gate_dst"; then
    cp "$gate_src" "$gate_dst"
    git add -- "$gate_dst"
    echo "pre-commit: refreshed $gate_dst from canonical $gate_src."
fi

# --- 3. Warn about unused imports in staged Odin files ------------------
# Odin does not warn on an unused import by default, so copy-pasted import
# headers accumulate. Warn here and let the commit through; CI runs the same
# check through scripts/build.sh and fails on it.
if staged -- '*.odin' | grep -qz . && ! scripts/vet-imports.sh; then
    echo "pre-commit: warning: unused imports in app/ (fatal in CI)." >&2
fi

exit 0
